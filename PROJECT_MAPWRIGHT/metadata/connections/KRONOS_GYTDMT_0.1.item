      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYQ68L8EfGRB8-8_sKJtQ" name="SCENARIO_NAME" comment="Gonderimin gerceklestirildigi senaryonun adini tutan alandir. Ilgili iletisimin hangi is kurali kampanya akisi veya tetikleyici senaryo kapsaminda olusturuldugunu gosterir. Raporlama izleme ve gonderimlerin senaryo bazinda ayristirilmasi amaciyla kullanilir." label="SCENARIO_NAME" length="80" sourceType="VARCHAR2" talendType="id_String">
        <taggedValue xmi:id="_CpYQ7ML8EfGRB8-8_sKJtQ" tag="Comment" value="Gonderimin gerceklestirildigi senaryonun adini tutan alandir. Ilgili iletisimin hangi is kurali kampanya akisi veya tetikleyici senaryo kapsaminda olusturuldugunu gosterir. Raporlama izleme ve gonderimlerin senaryo bazinda ayristirilmasi amaciyla kullanilir."/>
        <initialValue xsi:type="relational:TdExpression" xmi:id="_CpYQ7cL8EfGRB8-8_sKJtQ" language="COLUMN_DEF"/>
