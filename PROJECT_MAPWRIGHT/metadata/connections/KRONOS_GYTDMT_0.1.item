    <ownedElement xsi:type="relational:TdTable" xmi:id="_yTVPUML7EfGRB8-8_sKJtQ" name="T_DIM_IPO_BROKERAGE_COMPANY" id="_yTUoQML7EfGRB8-8_sKJtQ" comment="The T_DIM_IPO_BROKERAGE_COMPANY table is designed to store information about brokerage firms participating in public offerings, including consortium leaders and consortium members. This table is used to track which brokerage firm is involved in a specific offering and in what role (leader or consortium member). It also includes information about the offering type (consortium or exchange-based), leadership details, and flags indicating the role of Garanti Yatirim." label="T_DIM_IPO_BROKERAGE_COMPANY" tableType="TABLE">
      <taggedValue xmi:id="_yTVPUcL7EfGRB8-8_sKJtQ" tag="Comment" value="The T_DIM_IPO_BROKERAGE_COMPANY table is designed to store information about brokerage firms participating in public offerings, including consortium leaders and consortium members. This table is used to track which brokerage firm is involved in a specific offering and in what role (leader or consortium member). It also includes information about the offering type (consortium or exchange-based), leadership details, and flags indicating the role of Garanti Yatirim."/>
