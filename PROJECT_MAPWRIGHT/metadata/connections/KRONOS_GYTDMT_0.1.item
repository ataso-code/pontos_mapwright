    <ownedElement xsi:type="relational:TdTable" xmi:id="_H52r0cL8EfGRB8-8_sKJtQ" name="T_RPT_CUSTOMER_FIRST_TRANSACTION" id="_H52r0ML8EfGRB8-8_sKJtQ" comment="The table stores customers based on their MARS number and contains the first and last transaction dates for each customer, segmented by Transaction Type derived from the EVENT_SOURCE_CODE field and Channel Type derived from the CHANNEL_ID field.It enables the analysis of customer activity by providing visibility into the first and most recent transactions performed through different transaction types and channels, supporting customer behavior analysis and transaction activity monitoring." label="T_RPT_CUSTOMER_FIRST_TRANSACTION" tableType="TABLE">
