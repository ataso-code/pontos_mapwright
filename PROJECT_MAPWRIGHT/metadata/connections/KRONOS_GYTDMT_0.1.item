        <sqlDataType xmi:id="_CpYRAsL8EfGRB8-8_sKJtQ" name="NUMBER" numericPrecisionRadix="10" javaDataType="2" nullable="columnNullable"/>
      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYRA8L8EfGRB8-8_sKJtQ" name="RESPONSE_DESC" comment="Musterinin ilgili iletisime verdigi yaniti ifade eden aciklamadir. Response un turunu aciklamak icin kullanilir. Musteri davranislarinin analiz edilmesi yanit tiplerinin ayristirilmasi ve iletisim sonuclarinin raporlanmasi acisindan onemli bir alandir." label="RESPONSE_DESC" length="612" sourceType="VARCHAR2" talendType="id_String">
        <taggedValue xmi:id="_CpYRBML8EfGRB8-8_sKJtQ" tag="Comment" value="Musterinin ilgili iletisime verdigi yaniti ifade eden aciklamadir. Response un turunu aciklamak icin kullanilir. Musteri davranislarinin analiz edilmesi yanit tiplerinin ayristirilmasi ve iletisim sonuclarinin raporlanmasi acisindan onemli bir alandir."/>
