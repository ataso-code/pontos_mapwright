      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYRH8L8EfGRB8-8_sKJtQ" name="EMAIL_FROM_NAME" comment="Email gonderimlerinde alici tarafinda gorunen gonderen adini tutar. Kullanicinin gelen kutusunda mailin hangi isimle gorundugunu ifade eder. Marka gorunurlugu kullanici deneyimi ve gonderici kimliginin yonetimi acisindan onemlidir." label="EMAIL_FROM_NAME" length="50" sourceType="VARCHAR2" talendType="id_String">
        <taggedValue xmi:id="_CpYRIML8EfGRB8-8_sKJtQ" tag="Comment" value="Email gonderimlerinde alici tarafinda gorunen gonderen adini tutar. Kullanicinin gelen kutusunda mailin hangi isimle gorundugunu ifade eder. Marka gorunurlugu kullanici deneyimi ve gonderici kimliginin yonetimi acisindan onemlidir."/>
