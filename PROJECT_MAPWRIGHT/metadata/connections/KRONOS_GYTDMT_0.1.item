      <feature xsi:type="relational:TdColumn" xmi:id="_CpYRK8L8EfGRB8-8_sKJtQ" name="EMAIL_SUBJECT2" comment="Optimizasyonlu veya alternatifli email gonderimlerinde kullanilan ikinci konu bilgisini tutar. Ozellikle subject testleri veya varyasyonlu gonderim yapilarinda alternatif baslik olarak kullanilir. Performans karsilastirmalarinda degerlendirilir." label="EMAIL_SUBJECT2" length="150" sourceType="VARCHAR2" talendType="id_String">
