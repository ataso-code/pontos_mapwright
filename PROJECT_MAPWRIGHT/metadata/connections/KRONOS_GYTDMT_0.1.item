      <feature xsi:type="relational:TdColumn" xmi:id="_CpYRJ8L8EfGRB8-8_sKJtQ" name="EMAIL_SUBJECT" comment="Email gonderiminde kullanilan birincil konu bilgisini tutar. Alicinin gelen kutusunda gorecegi ana baslik bilgisidir. Acilma orani A/B test analizleri ve iletisim iceriginin ozetlenmesi acisindan onemli bir alandir." label="EMAIL_SUBJECT" length="150" sourceType="VARCHAR2" talendType="id_String">
