      <feature xsi:type="relational:TdColumn" xmi:id="_CpYRI8L8EfGRB8-8_sKJtQ" name="EMAIL_FROM_ADDRESS" comment="Email gonderimlerinde kullanilan gonderen eposta adresini tutan alandir. Mailin teknik olarak hangi eposta adresinden gonderildigini gosterir. Gonderici dogrulama teslimat takibi whitelist kontrolleri ve mail altyapisi analizlerinde kullanilir." label="EMAIL_FROM_ADDRESS" length="50" sourceType="VARCHAR2" talendType="id_String">
