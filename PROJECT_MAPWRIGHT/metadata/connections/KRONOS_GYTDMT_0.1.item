      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYQ78L8EfGRB8-8_sKJtQ" name="CONTENT_TYPE" comment="Mesaj iceriginin turunu ifade eden alandir. Icerigin yapisina veya sinifina gore ornegin K veya B gibi onceden tanimli kodlarla beslenir. Bu alan gonderim iceriginin hangi kategoride degerlendirilecegini belirlemek ve icerik bazli segmentasyon yapmak icin kullanilir." label="CONTENT_TYPE" length="24" sourceType="VARCHAR2" talendType="id_String">
        <taggedValue xmi:id="_CpYQ8ML8EfGRB8-8_sKJtQ" tag="Comment" value="Mesaj iceriginin turunu ifade eden alandir. Icerigin yapisina veya sinifina gore ornegin K veya B gibi onceden tanimli kodlarla beslenir. Bu alan gonderim iceriginin hangi kategoride degerlendirilecegini belirlemek ve icerik bazli segmentasyon yapmak icin kullanilir."/>
        <initialValue xsi:type="relational:TdExpression" xmi:id="_CpYQ8cL8EfGRB8-8_sKJtQ" language="COLUMN_DEF"/>
        <sqlDataType xmi:id="_CpYQ8sL8EfGRB8-8_sKJtQ" name="VARCHAR2" numericPrecisionRadix="10" javaDataType="12" nullable="columnNullable"/>
      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYQ88L8EfGRB8-8_sKJtQ" name="DELIVERY_ID" comment="Her bir gonderim kaydina ozel olarak uretilen benzersiz anahtar bilgidir. Ayni gonderimin sistem uzerinde tekil olarak izlenmesini saglar. Tekrar eden kayitlarin kontrolu log takibi hata analizi ve kaynak sistem ile hedef sistem arasindaki eslestirmelerde referans alani olarak kullanilabilir." label="DELIVERY_ID" length="17" sourceType="NUMBER" talendType="id_BigDecimal">
        <taggedValue xmi:id="_CpYQ9ML8EfGRB8-8_sKJtQ" tag="Comment" value="Her bir gonderim kaydina ozel olarak uretilen benzersiz anahtar bilgidir. Ayni gonderimin sistem uzerinde tekil olarak izlenmesini saglar. Tekrar eden kayitlarin kontrolu log takibi hata analizi ve kaynak sistem ile hedef sistem arasindaki eslestirmelerde referans alani olarak kullanilabilir."/>
        <initialValue xsi:type="relational:TdExpression" xmi:id="_CpYQ9cL8EfGRB8-8_sKJtQ" language="COLUMN_DEF"/>
        <sqlDataType xmi:id="_CpYQ9sL8EfGRB8-8_sKJtQ" name="NUMBER" numericPrecisionRadix="10" javaDataType="2" nullable="columnNullable"/>
      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYQ98L8EfGRB8-8_sKJtQ" name="DELIVERY_TIME" comment="Gonderimin fiilen gerceklestigi tarih ve zaman bilgisini tutan alandir. Iletisimin kullaniciya hangi anda iletildiginin izlenmesi zaman bazli analizlerin yapilmasi ve gonderim performansinin olculmesi acisindan kritik oneme sahiptir. Genellikle timestamp formatinda tutulur." label="DELIVERY_TIME" length="11" precision="6" sourceType="TIMESTAMP" talendType="id_Date" pattern="&quot;dd-MM-yyyy&quot;">
        <taggedValue xmi:id="_CpYQ-ML8EfGRB8-8_sKJtQ" tag="Comment" value="Gonderimin fiilen gerceklestigi tarih ve zaman bilgisini tutan alandir. Iletisimin kullaniciya hangi anda iletildiginin izlenmesi zaman bazli analizlerin yapilmasi ve gonderim performansinin olculmesi acisindan kritik oneme sahiptir. Genellikle timestamp formatinda tutulur."/>
        <initialValue xsi:type="relational:TdExpression" xmi:id="_CpYQ-cL8EfGRB8-8_sKJtQ" language="COLUMN_DEF"/>
        <sqlDataType xmi:id="_CpYQ-sL8EfGRB8-8_sKJtQ" name="TIMESTAMP" numericPrecision="6" numericPrecisionRadix="10" javaDataType="93" nullable="columnNullable"/>
      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYQ-8L8EfGRB8-8_sKJtQ" name="RESPONSE_CHANGE_TIME" comment="Musteriden alinan response bilgisinin sisteme yansidigi tarih ve zaman bilgisini tutan alandir. Musterinin iletisime verdigi yanitin hangi anda kaydedildigini gosterir. Response surelerinin olculmesi zaman bazli analizler musteri etkilesim takibi ve operasyonel performans degerlendirmelerinde kullanilir." label="RESPONSE_CHANGE_TIME" length="11" precision="6" sourceType="TIMESTAMP" talendType="id_Date" pattern="&quot;dd-MM-yyyy&quot;">
        <taggedValue xmi:id="_CpYQ_ML8EfGRB8-8_sKJtQ" tag="Comment" value="Musteriden alinan response bilgisinin sisteme yansidigi tarih ve zaman bilgisini tutan alandir. Musterinin iletisime verdigi yanitin hangi anda kaydedildigini gosterir. Response surelerinin olculmesi zaman bazli analizler musteri etkilesim takibi ve operasyonel performans degerlendirmelerinde kullanilir."/>
