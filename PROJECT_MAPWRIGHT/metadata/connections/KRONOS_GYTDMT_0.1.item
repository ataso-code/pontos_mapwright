    <ownedElement xsi:type="relational:TdTable" xmi:id="_CHg5wcL8EfGRB8-8_sKJtQ" name="T_FCT_IPO_DEMANDS" id="_CHg5wML8EfGRB8-8_sKJtQ" comment="T_FCT_IPO_DEMANDS is a model table that consolidates operational data related to Initial Public Offering (IPO) demand processes. It stores comprehensive information about investor demands, including demand dates, account details, investor and payment types, requested and allocated quantities and amounts, refund and credit information, as well as pre-demand and installment-based demand details. The table serves as a core data source for IPO demand analysis, allocation and realization reporting, investor behavior analysis, financial reporting, and enterprise data warehouse processes." label="T_FCT_IPO_DEMANDS" tableType="TABLE">
      <taggedValue xmi:id="_CHg5wsL8EfGRB8-8_sKJtQ" tag="Comment" value="T_FCT_IPO_DEMANDS is a model table that consolidates operational data related to Initial Public Offering (IPO) demand processes. It stores comprehensive information about investor demands, including demand dates, account details, investor and payment types, requested and allocated quantities and amounts, refund and credit information, as well as pre-demand and installment-based demand details. The table serves as a core data source for IPO demand analysis, allocation and realization reporting, investor behavior analysis, financial reporting, and enterprise data warehouse processes."/>
