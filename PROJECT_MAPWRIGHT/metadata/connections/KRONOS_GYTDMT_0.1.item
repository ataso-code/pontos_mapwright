    <ownedElement xsi:type="relational:TdTable" xmi:id="_5UasccL7EfGRB8-8_sKJtQ" name="T_FCT_BCP_SECURITY_COLLATERAL" id="_5UascML7EfGRB8-8_sKJtQ" comment="Istirak Konsolidasyon Projesi kapsaminda finansal raporlamaya konu olan Menkul kiymet teminat kayitlarini iceren detay tablodur. Her satir, bir menkul kiymetin teminat olarak iliskilendirildigi islem veya referans islemini temsil eder. Tablo teminata konu menkul kiymetin ISIN bilgisi, nominal teminat tutari, para birimi, kaynak urun/islem turu, ilgili referans islem veya kontrat bilgisi, karsi taraf bilgisi ve istirak bilgilerini icerir." label="T_FCT_BCP_SECURITY_COLLATERAL" tableType="TABLE">
