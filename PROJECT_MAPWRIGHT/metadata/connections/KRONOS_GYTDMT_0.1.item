      <feature xsi:type="relational:TdColumn" xmi:id="_CpYRB8L8EfGRB8-8_sKJtQ" name="TREATMENT_CODE" comment="Bu alan Contact Hist tablosundaki DELIVERY_ID alani ile eslesen gonderim bazli benzersiz kimlik bilgisini tutar. Her bir iletisim veya gonderim kaydinin sistem uzerinde tekil olarak izlenmesini saglar. Kaynak ve hedef sistemler arasindaki veri eslestirmelerinde gonderim gecmisinin takibinde hata analizlerinde ve veri tutarliligi kontrollerinde onemli bir referans alani olarak kullanilir." label="TREATMENT_CODE" length="17" sourceType="NUMBER" talendType="id_BigDecimal">
        <taggedValue xmi:id="_CpYRCML8EfGRB8-8_sKJtQ" tag="Comment" value="Bu alan Contact Hist tablosundaki DELIVERY_ID alani ile eslesen gonderim bazli benzersiz kimlik bilgisini tutar. Her bir iletisim veya gonderim kaydinin sistem uzerinde tekil olarak izlenmesini saglar. Kaynak ve hedef sistemler arasindaki veri eslestirmelerinde gonderim gecmisinin takibinde hata analizlerinde ve veri tutarliligi kontrollerinde onemli bir referans alani olarak kullanilir."/>
        <initialValue xsi:type="relational:TdExpression" xmi:id="_CpYRCcL8EfGRB8-8_sKJtQ" language="COLUMN_DEF"/>
        <sqlDataType xmi:id="_CpYRCsL8EfGRB8-8_sKJtQ" name="NUMBER" numericPrecisionRadix="10" javaDataType="2" nullable="columnNullable"/>
      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYRC8L8EfGRB8-8_sKJtQ" name="CREATE_USER_ID" comment="Bu alan kaydin ilk olusturulmasi sirasinda islemi gerceklestiren kullaniciya ait kimlik bilgisini tutar. Ilgili verinin hangi kullanici tarafindan yaratildigini gosterir ve kayit olusturma surecinin izlenebilirligini saglar. Denetim ve kontrol sureclerinde islem gecmisinin takibinde kullanici bazli sorumluluklarin belirlenmesinde ve veri olusturma kaynaklarinin analiz edilmesinde onemli bir referans alani olarak kullanilir." label="CREATE_USER_ID" length="10" sourceType="VARCHAR2" talendType="id_String">
        <taggedValue xmi:id="_CpYRDML8EfGRB8-8_sKJtQ" tag="Comment" value="Bu alan kaydin ilk olusturulmasi sirasinda islemi gerceklestiren kullaniciya ait kimlik bilgisini tutar. Ilgili verinin hangi kullanici tarafindan yaratildigini gosterir ve kayit olusturma surecinin izlenebilirligini saglar. Denetim ve kontrol sureclerinde islem gecmisinin takibinde kullanici bazli sorumluluklarin belirlenmesinde ve veri olusturma kaynaklarinin analiz edilmesinde onemli bir referans alani olarak kullanilir."/>
        <initialValue xsi:type="relational:TdExpression" xmi:id="_CpYRDcL8EfGRB8-8_sKJtQ" language="COLUMN_DEF"/>
        <sqlDataType xmi:id="_CpYRDsL8EfGRB8-8_sKJtQ" name="VARCHAR2" numericPrecisionRadix="10" javaDataType="12" nullable="columnNullable"/>
      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYRD8L8EfGRB8-8_sKJtQ" name="OFFER_NAME" comment="Kampanya veya gonderim kapsaminda musteriye sunulan teklifin adini tutan alandir. Bu alan iletilen fayda urun hizmet veya kampanya teklifinin kullaniciya nasil adlandirildigini gosterir. Ornegin belirli bir kredi teklifi kart kampanyasi yatirim firsati veya ozel musteri onerisi bu alanda anlamli bir isimle saklanabilir. Teklifin is kullanicilari tarafindan kolayca taninmasi raporlanmasi benzer tekliflerden ayristirilmasi ve kampanya performans analizlerinde teklif bazli kirilim alinabilmesi amaciyla kullanilir." label="OFFER_NAME" length="150" sourceType="VARCHAR2" talendType="id_String">
        <taggedValue xmi:id="_CpYREML8EfGRB8-8_sKJtQ" tag="Comment" value="Kampanya veya gonderim kapsaminda musteriye sunulan teklifin adini tutan alandir. Bu alan iletilen fayda urun hizmet veya kampanya teklifinin kullaniciya nasil adlandirildigini gosterir. Ornegin belirli bir kredi teklifi kart kampanyasi yatirim firsati veya ozel musteri onerisi bu alanda anlamli bir isimle saklanabilir. Teklifin is kullanicilari tarafindan kolayca taninmasi raporlanmasi benzer tekliflerden ayristirilmasi ve kampanya performans analizlerinde teklif bazli kirilim alinabilmesi amaciyla kullanilir."/>
        <initialValue xsi:type="relational:TdExpression" xmi:id="_CpYREcL8EfGRB8-8_sKJtQ" language="COLUMN_DEF"/>
        <sqlDataType xmi:id="_CpYREsL8EfGRB8-8_sKJtQ" name="VARCHAR2" numericPrecisionRadix="10" javaDataType="12" nullable="columnNullable"/>
      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYRE8L8EfGRB8-8_sKJtQ" name="SERVICE_CODE" comment="Ozellikle SMS gonderimlerinde kullanilan hizmet veya gonderici kod bilgisidir. Mesajin hangi servis numarasi ya da hangi uygulama kodu uzerinden ciktigini gosterir. Ornegin G.BBVAYTRM gibi degerler alabilir. Servis bazli ayristirma teknik izleme ve entegrasyon takibi icin kullanilir." label="SERVICE_CODE" length="20" sourceType="VARCHAR2" talendType="id_String">
        <taggedValue xmi:id="_CpYRFML8EfGRB8-8_sKJtQ" tag="Comment" value="Ozellikle SMS gonderimlerinde kullanilan hizmet veya gonderici kod bilgisidir. Mesajin hangi servis numarasi ya da hangi uygulama kodu uzerinden ciktigini gosterir. Ornegin G.BBVAYTRM gibi degerler alabilir. Servis bazli ayristirma teknik izleme ve entegrasyon takibi icin kullanilir."/>
        <initialValue xsi:type="relational:TdExpression" xmi:id="_CpYRFcL8EfGRB8-8_sKJtQ" language="COLUMN_DEF"/>
        <sqlDataType xmi:id="_CpYRFsL8EfGRB8-8_sKJtQ" name="VARCHAR2" numericPrecisionRadix="10" javaDataType="12" nullable="columnNullable"/>
      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYRF8L8EfGRB8-8_sKJtQ" name="MESSAGE_TYPE" comment="Mesajin icerik yapisinin turunu belirtir. Ozellikle sablonsuz SMS gonderimlerinde icerigin jenerik mi yoksa parametrik mi oldugunu ifade eder. Ayrica AYNI/FARKLI gibi degerlerle icerik varyasyonlarinin izlenmesini saglayabilir. Icerik uretim mantiginin analiz edilmesinde kullanilir." label="MESSAGE_TYPE" length="10" sourceType="VARCHAR2" talendType="id_String">
        <taggedValue xmi:id="_CpYRGML8EfGRB8-8_sKJtQ" tag="Comment" value="Mesajin icerik yapisinin turunu belirtir. Ozellikle sablonsuz SMS gonderimlerinde icerigin jenerik mi yoksa parametrik mi oldugunu ifade eder. Ayrica AYNI/FARKLI gibi degerlerle icerik varyasyonlarinin izlenmesini saglayabilir. Icerik uretim mantiginin analiz edilmesinde kullanilir."/>
        <initialValue xsi:type="relational:TdExpression" xmi:id="_CpYRGcL8EfGRB8-8_sKJtQ" language="COLUMN_DEF"/>
        <sqlDataType xmi:id="_CpYRGsL8EfGRB8-8_sKJtQ" name="VARCHAR2" numericPrecisionRadix="10" javaDataType="12" nullable="columnNullable"/>
      </feature>
      <feature xsi:type="relational:TdColumn" xmi:id="_CpYRG8L8EfGRB8-8_sKJtQ" name="SMS_TEXT" comment="Sablonsuz SMS gonderimlerinde gonderilen gercek SMS metnini tutan alandir. Musteriye iletilen ham mesaj iceriginin sistem uzerinde saklanmasini saglar. Icerik dogrulama sikayet inceleme denetim ve gecmis gonderimlerin izlenmesi amaciyla kullanilir." label="SMS_TEXT" length="612" sourceType="VARCHAR2" talendType="id_String">
        <taggedValue xmi:id="_CpYRHML8EfGRB8-8_sKJtQ" tag="Comment" value="Sablonsuz SMS gonderimlerinde gonderilen gercek SMS metnini tutan alandir. Musteriye iletilen ham mesaj iceriginin sistem uzerinde saklanmasini saglar. Icerik dogrulama sikayet inceleme denetim ve gecmis gonderimlerin izlenmesi amaciyla kullanilir."/>
        <initialValue xsi:type="relational:TdExpression" xmi:id="_CpYRHcL8EfGRB8-8_sKJtQ" language="COLUMN_DEF"/>
