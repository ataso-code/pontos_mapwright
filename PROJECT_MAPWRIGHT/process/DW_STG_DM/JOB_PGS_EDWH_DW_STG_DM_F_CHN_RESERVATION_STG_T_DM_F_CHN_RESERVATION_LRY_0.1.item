        <DBMapperTableEntries name="INSERT_DTTM" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUN_ID" expression="NULL"/>
        <DBMapperTableEntries name="SALES_CHN_ID" expression="T2.SALES_CHN_ID"/>
        <DBMapperTableEntries name="IP_COUNTRY_ID" expression="T2.IP_COUNTRY_ID"/>
        <DBMapperTableEntries name="RESIDENCE_COUNTRY_ID" expression="T2.RESIDENCE_COUNTRY_ID"/>
        <DBMapperTableEntries name="PNR_INT_FLAG" expression="T2.INT_FLAG"/>
        <DBMapperTableEntries name="GRP_FLAG" expression="T2.GRP_FLAG"/>
        <DBMapperTableEntries name="FF_PNR_CNT" expression="COUNT(DISTINCT CASE WHEN T2.FF_ID > 0 THEN T2.PNR_ID ELSE NULL END)"/>
        <DBMapperTableEntries name="PNR_CNT" expression="COUNT(DISTINCT T2.PNR_ID)"/>
        <DBMapperTableEntries name="FF_TRN_CNT" expression="COUNT(DISTINCT CASE WHEN T2.FF_ID > 0 THEN T1.CPN_ID ELSE NULL END)"/>
        <DBMapperTableEntries name="TRN_CNT" expression="COUNT(DISTINCT T1.CPN_ID)"/>
        <FilterEntries name="where" expression="(T1.TRN_DT BETWEEN T3.VALID_FROM_DT AND T3.VALID_TO_DT AND T3.PNR_STATUS_CODE = 'TK') AND (T1.TRN_DT IN (SELECT DISTINCT TRN_DT FROM DW_CDL.CDL_F_COUPON_SALES A WHERE A.INSERT_DTTM BETWEEN TO_DATE('&quot; + context.VAR_FROM_ETL_DATE + &quot;', 'DD.MM.YYYY') + 1 AND (TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') + 2) - INTERVAL '1' SECOND))" filterKind="WHERE_CLAUSE"/>
        <FilterEntries name="other" expression="GROUP BY T1.TRN_DT, T2.SALES_CHN_ID, T2.IP_COUNTRY_ID, T2.RESIDENCE_COUNTRY_ID, T2.INT_FLAG, T2.GRP_FLAG" filterKind="OTHER_FILTER"/>
      </OutputTables>
