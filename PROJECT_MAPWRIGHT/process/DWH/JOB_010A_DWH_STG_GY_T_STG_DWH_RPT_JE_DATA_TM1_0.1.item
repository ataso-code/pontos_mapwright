      <InputTables name="EXP_AMT" tableName="EXP_AMT" joinType="LEFT_OUTER_JOIN" alias="EXP_AMT">
        <DBMapperTableEntries name="ORG_ID" expression="s.ORG_ID" join="true" operator="="/>
        <DBMapperTableEntries name="DOCUMENT_NO" expression="s.DOCUMENT_NO" join="true" operator="="/>
        <DBMapperTableEntries name="SUM_AMOUNT"/>
      </InputTables>
      <OutputTables name="T_STG_DWH_RPT_JE_DATA_TM1" tableName="T_STG_DWH_RPT_JE_DATA_TM1">
        <DBMapperTableEntries name="ETL_DATE" expression="TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY')"/>
        <DBMapperTableEntries name="DWH_SOURCE_CODE" expression="'GTP'"/>
        <DBMapperTableEntries name="INSERT_TIMESTAMP" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUNID" expression="NULL"/>
        <DBMapperTableEntries name="ENTRY_DATE" expression="NVL(s.CREATED, TO_DATE('1900-01-01', 'YYYY-MM-DD'))"/>
        <DBMapperTableEntries name="VOUCHER_DATE" expression="NVL(s.POSTING_DATE, TO_DATE('1900-01-01', 'YYYY-MM-DD'))"/>
        <DBMapperTableEntries name="OFFSET_RECORD_VALUE" expression="NVL(ABS(s.AMOUNT), 0)"/>
        <DBMapperTableEntries name="DEBIT_VALUE" expression="ABS(CASE WHEN s.AMOUNT &lt; 0 THEN s.AMOUNT ELSE 0 END)"/>
        <DBMapperTableEntries name="CREDIT_VALUE" expression="ABS(CASE WHEN s.AMOUNT > 0 THEN s.AMOUNT ELSE 0 END)"/>
        <DBMapperTableEntries name="EXCHANGE_RATE" expression="10000"/>
        <DBMapperTableEntries name="VOUCHER_AMOUNT" expression="NVL(EXP_AMT.SUM_AMOUNT, 0)"/>
        <DBMapperTableEntries name="ACCOUNT_NAME" expression="NVL(a.CHART_ACC_NAME, 0)"/>
        <DBMapperTableEntries name="ACCOUNT_NUMBER" expression="NVL(a.GL_ACCOUNT_NO, '-99')"/>
        <DBMapperTableEntries name="FINANCIAL_TABLE_ITEM" expression="'?'"/>
        <DBMapperTableEntries name="CREATED_BY_USER" expression="NVL(o.PARTY_NAME, '?')"/>
        <DBMapperTableEntries name="ACCOUNTING_VOUCHER_NUMBER" expression="NVL(s.DOCUMENT_NO, 0)"/>
        <DBMapperTableEntries name="ACCOUNTING_LEG_NUMBER" expression="NVL(s.COUNT_NO, '-99')"/>
        <DBMapperTableEntries name="VOUCHER_PERIOD" expression="NVL(TO_CHAR(s.POSTING_DATE, 'MM'), '-99')"/>
        <DBMapperTableEntries name="UPDATED_BY_USER" expression="NVL(g.PARTY_NAME, '?')"/>
        <DBMapperTableEntries name="ENTRY_TYPE" expression="CASE WHEN d.ENUM_CODE = 'FSI_MANUAL_JOURNAL_ENTRY' THEN 'Manuel' ELSE 'Otomatik' END"/>
        <DBMapperTableEntries name="VOUCHER_DESCRIPTION" expression="NVL(s.DESCRIPTION, '?')"/>
        <DBMapperTableEntries name="OFFSET_RECORD_DESCRIPTION" expression="NVL(s.DESCRIPTION, '?')"/>
        <FilterEntries name="where" expression="s.ORG_ID = '0000-000001-ORG' AND s.POSTING_DATE = TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY')" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
    </nodeData>
