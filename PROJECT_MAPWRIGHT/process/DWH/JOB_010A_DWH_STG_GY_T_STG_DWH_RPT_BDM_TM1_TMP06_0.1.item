        <FilterEntries name="where" expression="(EVE.ETL_DATE >= PR.GY_ACC_OPEN_DATE) AND (4 > 1 AND PR.GY_ACC_OPEN_DATE BETWEEN (TRUNC(TRUNC(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY'), 'MM') - 1, 'MM')) AND (TRUNC(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY'), 'MM') - 1) AND PR.ACC_CON_DATE BETWEEN (TRUNC(TRUNC(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY'), 'MM') - 1, 'MM')) AND (TRUNC(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY'), 'MM') - 1) AND PR.GY_REL_TP_CODE = 'CON' AND EVE.NET_COMM_AMOUNT > 0)" filterKind="WHERE_CLAUSE"/>
        <FilterEntries name="other" expression="GROUP BY PR.GY_PF_CODE" filterKind="OTHER_FILTER"/>
      </OutputTables>
