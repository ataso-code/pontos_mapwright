        <DBMapperTableEntries name="SETTLEMENT_TRANS_NO" expression="TB.SETTLEMENT_TRANS_NO"/>
        <DBMapperTableEntries name="ISE_ORDER_NO" expression="TB.ORDER_NO"/>
        <DBMapperTableEntries name="EVENT_CLS_ID" expression="CASE WHEN EC.IS_WARRANT = 1 AND TH.DEBIT_CREDIT = 'CREDIT' THEN 'WARBUY~40004' WHEN EC.IS_WARRANT = 1 AND TH.DEBIT_CREDIT = 'DEBIT' THEN 'WARSELL~40004' WHEN TH.DEBIT_CREDIT = 'CREDIT' THEN 'EQBUY~40004' WHEN TH.DEBIT_CREDIT = 'DEBIT' THEN 'EQSELL~40004' END"/>
        <DBMapperTableEntries name="UNIT" expression="TB.UNITS"/>
