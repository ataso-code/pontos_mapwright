      <OutputTables name="EXP_CTE" tableName="EXP_CTE">
        <DBMapperTableEntries name="EVENT_ID" expression="TH.TRANSACTION_ID || '~30019'"/>
        <DBMapperTableEntries name="DATE_ID" expression="TO_CHAR(TB.TRANSACTION_DATE, 'YYYYMMDD') || '~20003'"/>
        <DBMapperTableEntries name="CUS_ID" expression="TB.CUSTOMER_ID || '~30007'"/>
        <DBMapperTableEntries name="ACC_ID" expression="TB.ACCOUNT_ID || '~30003'"/>
