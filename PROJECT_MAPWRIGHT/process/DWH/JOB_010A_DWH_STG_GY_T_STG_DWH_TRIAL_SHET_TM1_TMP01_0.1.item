        <DBMapperTableEntries name="ETL_DATE" expression="GL.ETL_DATE"/>
        <DBMapperTableEntries name="INSERT_TIMESTAMP" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUNID" expression="NULL"/>
        <DBMapperTableEntries name="ACC_ID" expression="GL.ACC_ID"/>
        <DBMapperTableEntries name="COA_ID" expression="GL.COA_ID"/>
        <DBMapperTableEntries name="SUM_EXPENSE_VOLUME" expression="SUM(CASE WHEN COA.IS_EXPENSE = 1 THEN GL.VOLUME ELSE 0 END)"/>
        <DBMapperTableEntries name="SUM_INCOME_VOLUME" expression="SUM(CASE WHEN COA.IS_INCOME = 1 THEN GL.VOLUME ELSE 0 END)"/>
        <DBMapperTableEntries name="SUM_ADVANCE_VOLUME" expression="SUM(CASE WHEN COA.COA_DESC LIKE '%Avans%' THEN GL.VOLUME ELSE 0 END)"/>
        <DBMapperTableEntries name="SUM_OTHER_VOLUME" expression="SUM(CASE WHEN NOT (COA.IS_EXPENSE = 1 OR COA.IS_INCOME = 1 OR COA.COA_DESC LIKE '%Avans%') THEN GL.VOLUME ELSE 0 END)"/>
        <FilterEntries name="other" expression="GROUP BY GL.ETL_DATE, GL.ACC_ID, GL.COA_ID" filterKind="OTHER_FILTER"/>
      </OutputTables>
    </nodeData>
