        <DBMapperTableEntries name="BRK_ACC_CLS_NAME" expression="BCL.BRK_ACC_CLS_NAME"/>
        <DBMapperTableEntries name="NORMAL_VOLUME" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'NORMAL' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="SEIZED_VOLUME" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'SEIZED' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="E_SEIZED_VOLUME" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'E_SEIZED' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="FOREX_COL_GRS_VOLUME" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'FOREXCOLLATERALBALANCE' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="FOREX_COL_NET_VOLUME" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'FOREXCOLLATERAL' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="CUSTODY_COL_VOLUME" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'CUSTODYCOLLATERAL' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="VIOPCUSTODY_COL_VOLUME" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'VIOPCUSTODY' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="OPTION_COL_VOLUME" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'OPT_COLL' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="FOREIGN_COL_VOLUME" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'FOREIGNCOLLATERAL' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="CFD_SHORT_BALANCE" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'CFD_SHORT' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="CFD_LONG_BALANCE" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'CFD_LONG' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="BLOCKED_VOLUME" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'BLOCKED' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="CREDIT_VOLUME" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'CREDIT' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="COL_AMOUNT" expression="SUM(CASE WHEN EXP_BAL.ACC_BAL_TP_NAME = 'COLLATERAL' THEN EXP_BAL.MARKET_CAP ELSE 0 END)"/>
        <DBMapperTableEntries name="CUS_ID" expression="EXP_BAL.CUS_ID"/>
        <DBMapperTableEntries name="DIV_ID" expression="EXP_BAL.DIV_ID"/>
        <FilterEntries name="where" expression="(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN BCL.DWH_VALID_FROM AND BCL.DWH_VALID_UNTIL) AND (TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN BRK.DWH_VALID_FROM AND BRK.DWH_VALID_UNTIL)" filterKind="WHERE_CLAUSE"/>
        <FilterEntries name="other" expression="GROUP BY EXP_BAL.DATE_ID, EXP_BAL.ACC_ID, EXP_BAL.GY_DIV_ID, BCL.BRK_ACC_CLS_ID, BCL.BRK_ACC_CLS_CODE, BCL.BRK_ACC_CLS_NAME, EXP_BAL.CUS_ID, EXP_BAL.DIV_ID" filterKind="OTHER_FILTER"/>
      </OutputTables>
    </nodeData>
