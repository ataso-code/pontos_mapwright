        <DBMapperTableEntries name="STAFF_ERROR_INT" expression="SUM(ERRTRX.STAFF_ERROR_INT)"/>
        <FilterEntries name="where" expression="(TO_CHAR(LAST_DAY(TO_DATE(ERRTRX.YEAR || '-' || ERRTRX.MONTH, 'YYYY-MM')), 'YYYY-MM-DD') BETWEEN PR.CUS_CON_DATE AND PR.CUS_DISCON_DATE) AND (PR.CUS_FILTER = 1) AND (4 > 2 AND YEAR = TO_NUMBER(TO_CHAR(TRUNC(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY'), 'MM') - 1, 'YYYY')) AND MONTH = TO_NUMBER(TO_CHAR(TRUNC(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY'), 'MM') - 1, 'MM')))" filterKind="WHERE_CLAUSE"/>
