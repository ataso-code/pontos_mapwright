        <DBMapperTableEntries name="SURVEY_CATEGORY_ID" expression="CASE WHEN LND_ESB_FLOW.FLOW_ID IN ('104b95b7-03a6-46c7-a693-26226b90ec47') THEN 1 WHEN LND_ESB_FLOW.FLOW_ID IN ('fafadc1e-bdb2-4da4-bbf8-89e4ec7ffcad') THEN 2 WHEN LND_ESB_FLOW.FLOW_ID IN ('f7dd519d-1448-4020-9f02-732f30f9c79f') THEN 3 WHEN LND_ESB_FLOW.FLOW_ID IN ('2cd89e34-cdc2-4f34-905f-53ced48b4a34', '1130672c-3ce5-451c-8b2a-a737bcdb7a65') THEN 4 WHEN LND_ESB_FLOW.FLOW_ID IN ('eb2ec133-2514-4fe0-bc55-524738e4ccef', 'cf3cf607-63e9-4fc9-94a5-37adc9f8c5aa') THEN 5 WHEN LND_ESB_FLOW.FLOW_ID IN ('27dee86e-43c8-49ce-b0e8-792489066dd0', '3ebbb42f-14f8-4c92-8e44-3ad8aca60555') THEN 6 WHEN LND_ESB_FLOW.FLOW_ID IN ('d2b1a2b3-821a-4aa0-b959-b37db974878f', '041af31c-0822-4d07-bc6c-ee543790cb01') THEN 7 WHEN LND_ESB_FLOW.FLOW_ID IN ('a7063ef8-23db-4898-a71e-fac602a7b046', '606ddd3e-5cc2-4bdd-b864-cb5980ea5994') THEN 8 WHEN LND_ESB_FLOW.FLOW_ID IN ('a5c02230-4cfc-4cc0-83b8-50c70fce5a54', 'e036d0ac-f4ee-493c-be96-317305dc72af') THEN 9 WHEN LND_ESB_FLOW.FLOW_ID IN ('6a030e34-2ad9-4f82-97f1-6172acaf4e13', '8c50e98e-f34a-4fcf-a8c6-b97292db7a28') THEN 10 ELSE -999 END"/>
        <FilterEntries name="where" expression="LND_ESB_FLOW.LANDING_DT = TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY')" filterKind="WHERE_CLAUSE"/>
