        <DBMapperTableEntries name="FNAME" expression="CASE WHEN INSTR(EXP_PNR.CLEANED_CONTACT_PERSON, ' ') > 0 THEN SUBSTR(EXP_PNR.CLEANED_CONTACT_PERSON, 1, INSTR(EXP_PNR.CLEANED_CONTACT_PERSON, ' ') - 1) ELSE EXP_PNR.CLEANED_CONTACT_PERSON END"/>
        <DBMapperTableEntries name="MNAME" expression="CASE WHEN INSTR(EXP_PNR.CLEANED_CONTACT_PERSON, ' ') > 0 AND INSTR(EXP_PNR.CLEANED_CONTACT_PERSON, ' ', 1, 2) = 0 THEN SUBSTR(EXP_PNR.CLEANED_CONTACT_PERSON, INSTR(EXP_PNR.CLEANED_CONTACT_PERSON, ' ') + 1) WHEN INSTR(EXP_PNR.CLEANED_CONTACT_PERSON, ' ', 1, 2) > 0 THEN SUBSTR(EXP_PNR.CLEANED_CONTACT_PERSON, INSTR(EXP_PNR.CLEANED_CONTACT_PERSON, ' ', 1, 1) + 1, INSTR(EXP_PNR.CLEANED_CONTACT_PERSON, ' ', 1, 2) - INSTR(EXP_PNR.CLEANED_CONTACT_PERSON, ' ', 1, 1) - 1) ELSE NULL END"/>
      </OutputTables>
