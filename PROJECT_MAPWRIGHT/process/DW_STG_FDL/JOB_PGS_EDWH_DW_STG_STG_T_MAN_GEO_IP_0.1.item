      <column key="false" length="4000" name="longfrom" nullable="true" precision="-1" sourceType="VARCHAR2" type="id_String" usefulColumn="true"/>
      <column key="false" length="38" name="longto" nullable="true" precision="10" sourceType="NUMBER" type="id_BigDecimal" usefulColumn="true"/>
    </metadata>
    <nodeData xsi:type="TalendDBMap:DBMapData">
      <InputTables name="EXP_C" tableName="EXP_C" joinType="NO_JOIN" alias="EXP_C">
        <DBMapperTableEntries name="geo_network"/>
        <DBMapperTableEntries name="geoname_id"/>
        <DBMapperTableEntries name="ip_dec"/>
        <DBMapperTableEntries name="cidr"/>
      </InputTables>
      <OutputTables name="EXP_r" tableName="EXP_r">
        <DBMapperTableEntries name="geoname_id" expression="EXP_C.geoname_id"/>
        <DBMapperTableEntries name="longfrom" expression="BITAND(EXP_C.ip_dec, POWER(2, 32) - POWER(2, 32 - EXP_C.cidr))"/>
        <DBMapperTableEntries name="longto" expression="BITAND(EXP_C.ip_dec, POWER(2, 32) - POWER(2, 32 - EXP_C.cidr)) + POWER(2, 32 - EXP_C.cidr) - 1"/>
      </OutputTables>
    </nodeData>
  </node>
