      </InputTables>
      <InputTables name="DW_LND.LND_MAN_GEO_IP_LOCATIONS" tableName="DW_LND.LND_MAN_GEO_IP_LOCATIONS" joinType="INNER_JOIN" alias="l">
        <DBMapperTableEntries name="LANDING_DT"/>
        <DBMapperTableEntries name="SYS_SRC_ID"/>
        <DBMapperTableEntries name="INSERT_DTTM"/>
        <DBMapperTableEntries name="INSERT_RUN_ID"/>
        <DBMapperTableEntries name="GEONAME_ID" expression="EXP_r.geoname_id" join="true" operator="="/>
        <DBMapperTableEntries name="LOCALE_CODE"/>
        <DBMapperTableEntries name="CONTINENT_CODE"/>
        <DBMapperTableEntries name="CONTINENT_NAME"/>
