        <DBMapperTableEntries name="SYS_SRC_ID"/>
        <DBMapperTableEntries name="INSERT_DTTM"/>
        <DBMapperTableEntries name="INSERT_RUN_ID"/>
        <DBMapperTableEntries name="GEO_NETWORK"/>
        <DBMapperTableEntries name="GEONAME_ID"/>
        <DBMapperTableEntries name="REGISTERED_COUNTRY_GEONAME_ID"/>
        <DBMapperTableEntries name="REPRESENTED_COUNTRY_GEONAME_ID"/>
        <DBMapperTableEntries name="IS_ANONYMOUS_PROXY"/>
        <DBMapperTableEntries name="IS_SATELLITE_PROVIDER"/>
      </InputTables>
      <OutputTables name="EXP_C" tableName="EXP_C">
        <DBMapperTableEntries name="geo_network" expression="LND_MAN_GEO_IP_V4.geo_network"/>
        <DBMapperTableEntries name="geoname_id" expression="LND_MAN_GEO_IP_V4.geoname_id"/>
        <DBMapperTableEntries name="ip_dec" expression="TO_NUMBER(REGEXP_SUBSTR(REGEXP_SUBSTR(LND_MAN_GEO_IP_V4.geo_network, '^[^/]+'), '\d+', 1, 1)) * 16777216 + TO_NUMBER(REGEXP_SUBSTR(REGEXP_SUBSTR(LND_MAN_GEO_IP_V4.geo_network, '^[^/]+'), '\d+', 1, 2)) * 65536 + TO_NUMBER(REGEXP_SUBSTR(REGEXP_SUBSTR(LND_MAN_GEO_IP_V4.geo_network, '^[^/]+'), '\d+', 1, 3)) * 256 + TO_NUMBER(REGEXP_SUBSTR(REGEXP_SUBSTR(LND_MAN_GEO_IP_V4.geo_network, '^[^/]+'), '\d+', 1, 4))"/>
        <DBMapperTableEntries name="cidr" expression="TO_NUMBER(REGEXP_SUBSTR(LND_MAN_GEO_IP_V4.geo_network, '\d+$'))"/>
      </OutputTables>
    </nodeData>
  </node>
  <node componentName="tELTOracleMap" posX="64" posY="160">
