      <OutputTables name="STG_T_MAN_GEO_IP" tableName="STG_T_MAN_GEO_IP">
        <DBMapperTableEntries name="SYS_SRC_ID" expression="EXP_MAN.SYS_SRC_ID"/>
        <DBMapperTableEntries name="INSERT_DTTM" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUN_ID" expression="NULL"/>
        <DBMapperTableEntries name="IP_FROM" expression="TRUNC(EXP_r.longfrom / 16777216) || '.' || TRUNC(MOD(EXP_r.longfrom, 16777216) / 65536) || '.' || TRUNC(MOD(EXP_r.longfrom, 65536) / 256) || '.' || MOD(EXP_r.longfrom, 256)"/>
        <DBMapperTableEntries name="IP_TO" expression="TRUNC(EXP_r.longto / 16777216) || '.' || TRUNC(MOD(EXP_r.longto, 16777216) / 65536) || '.' || TRUNC(MOD(EXP_r.longto, 65536) / 256) || '.' || MOD(EXP_r.longto, 256)"/>
