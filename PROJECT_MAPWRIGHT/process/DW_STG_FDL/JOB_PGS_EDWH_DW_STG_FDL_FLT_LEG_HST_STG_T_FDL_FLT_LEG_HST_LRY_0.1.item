        <DBMapperTableEntries name="Y_SEAT_CAP" expression="NVL(LEG.Y_CAP, 0)"/>
        <FilterEntries name="where" expression="LEG.LANDING_DT = TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY')" filterKind="WHERE_CLAUSE"/>
