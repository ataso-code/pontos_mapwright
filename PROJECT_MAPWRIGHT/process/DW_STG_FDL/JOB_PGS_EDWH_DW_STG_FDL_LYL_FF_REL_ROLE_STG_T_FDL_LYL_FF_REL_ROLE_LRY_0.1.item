        <DBMapperTableEntries name="FF_REL_ROLE_DESC_TEXT" expression="CASE R.NAME WHEN 'Child of' THEN 'FROM_MEMBER is the child of TO_MEMBER' WHEN 'Head of' THEN 'FROM_MEMBER is the leader of TO_MEMBER''s group' WHEN 'Asil Kart of' THEN 'FROM_MEMBER is the primary account for TO_MEMBER' WHEN 'Ek Kart of' THEN 'FROM_MEMBER is a supplementary card for TO_MEMBER' WHEN 'Asil Kart of Havuz' THEN 'FROM_MEMBER is the pool owner, TO_MEMBER is the member' WHEN 'Ek Kart of Havuz' THEN 'FROM_MEMBER is a pool member, TO_MEMBER is the owner' ELSE '-1' END"/>
