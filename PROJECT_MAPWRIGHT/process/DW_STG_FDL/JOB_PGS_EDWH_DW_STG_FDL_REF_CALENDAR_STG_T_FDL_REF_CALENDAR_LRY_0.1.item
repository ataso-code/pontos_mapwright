      <InputTables name="DW_LND.LND_MAN_CALENDAR" tableName="DW_LND.LND_MAN_CALENDAR" joinType="NO_JOIN" alias="t">
        <DBMapperTableEntries name="LANDING_DT"/>
        <DBMapperTableEntries name="SYS_SRC_ID"/>
        <DBMapperTableEntries name="INSERT_DTTM"/>
        <DBMapperTableEntries name="INSERT_RUN_ID"/>
        <DBMapperTableEntries name="DAY_ID"/>
      </InputTables>
      <OutputTables name="EXP_BASE_CALENDAR" tableName="EXP_BASE_CALENDAR">
        <DBMapperTableEntries name="SYS_SRC_ID" expression="t.SYS_SRC_ID"/>
        <DBMapperTableEntries name="DAY_ID" expression="t.DAY_ID"/>
        <DBMapperTableEntries name="LAST_YEAR_TODAY" expression="t.DAY_ID - 7 * 52"/>
        <DBMapperTableEntries name="DAY_END_DATE" expression="t.DAY_ID"/>
        <DBMapperTableEntries name="WEEK_DAY_FULL" expression="TO_CHAR(t.DAY_ID, 'Day', 'NLS_DATE_LANGUAGE=ENGLISH')"/>
        <DBMapperTableEntries name="WEEK_DAY_SHORT" expression="TO_CHAR(t.DAY_ID, 'DY', 'NLS_DATE_LANGUAGE=ENGLISH')"/>
        <DBMapperTableEntries name="WEEK_START_DT" expression="TRUNC(t.DAY_ID, 'IW')"/>
        <DBMapperTableEntries name="WEEK_END_DT" expression="TRUNC(t.DAY_ID, 'IW') + 6"/>
        <DBMapperTableEntries name="DAY_NUM_OF_WEEK" expression="(TRUNC(t.DAY_ID) - TRUNC(t.DAY_ID, 'IW') + 1)"/>
        <DBMapperTableEntries name="DAY_NUM_OF_MONTH" expression="TO_NUMBER(TO_CHAR(t.DAY_ID, 'DD'))"/>
        <DBMapperTableEntries name="DAY_NUM_OF_YEAR" expression="TO_NUMBER(TO_CHAR(t.DAY_ID, 'DDD'))"/>
        <DBMapperTableEntries name="MONTH_ID" expression="UPPER(TO_CHAR(t.DAY_ID, 'Mon', 'NLS_DATE_LANGUAGE=ENGLISH') || '-' || TO_CHAR(t.DAY_ID, 'YYYY'))"/>
        <DBMapperTableEntries name="MONTH_SHORT_DESC" expression="TO_CHAR(t.DAY_ID, 'Mon', 'NLS_DATE_LANGUAGE=ENGLISH') || ' ' || TO_CHAR(t.DAY_ID, 'YYYY')"/>
        <DBMapperTableEntries name="MONTH_LONG_DESC" expression="RTRIM(TO_CHAR(t.DAY_ID, 'Month', 'NLS_DATE_LANGUAGE=ENGLISH')) || ' ' || TO_CHAR(t.DAY_ID, 'YYYY')"/>
        <DBMapperTableEntries name="MONTH_SHORT" expression="TO_CHAR(t.DAY_ID, 'Mon', 'NLS_DATE_LANGUAGE=ENGLISH')"/>
        <DBMapperTableEntries name="MONTH_LONG" expression="TO_CHAR(t.DAY_ID, 'Month', 'NLS_DATE_LANGUAGE=ENGLISH')"/>
        <DBMapperTableEntries name="MONTH_YEAR" expression="TO_CHAR(t.DAY_ID, 'YYYYMM')"/>
        <DBMapperTableEntries name="MONTH_NUM_OF_YEAR" expression="TO_NUMBER(TO_CHAR(t.DAY_ID, 'MM'))"/>
        <DBMapperTableEntries name="MONTH_OF_YEAR" expression="TO_CHAR(t.DAY_ID, 'MM')"/>
        <DBMapperTableEntries name="QUARTER_ID" expression="'Q' || UPPER(TO_CHAR(t.DAY_ID, 'Q') || '-' || TO_CHAR(t.DAY_ID, 'YYYY'))"/>
        <DBMapperTableEntries name="QUARTER_NUM_OF_YEAR" expression="TO_NUMBER(TO_CHAR(t.DAY_ID, 'Q'))"/>
        <DBMapperTableEntries name="HALF_NUM_OF_YEAR" expression="CASE WHEN TO_NUMBER(TO_CHAR(t.DAY_ID, 'Q')) &lt;= 2 THEN 1 ELSE 2 END"/>
        <DBMapperTableEntries name="HALF_OF_YEAR_ID" expression="CASE WHEN TO_NUMBER(TO_CHAR(t.DAY_ID, 'Q')) &lt;= 2 THEN 'H1-' || TO_CHAR(t.DAY_ID, 'YYYY') ELSE 'H2-' || TO_CHAR(t.DAY_ID, 'YYYY') END"/>
        <DBMapperTableEntries name="YEAR_ID" expression="TO_CHAR(t.DAY_ID, 'YYYY')"/>
        <DBMapperTableEntries name="PGS_FLT_WEEK_YEAR" expression="CASE WHEN (TRUNC(TRUNC(t.DAY_ID, 'YEAR'), 'IW') + 7) > TRUNC(t.DAY_ID) THEN 1 ELSE TRUNC((TRUNC(t.DAY_ID) - (TRUNC(TRUNC(t.DAY_ID, 'YEAR'), 'IW') + 7)) / 7) + 2 END"/>
        <DBMapperTableEntries name="ISO_WEEK" expression="TO_NUMBER(TO_CHAR(t.DAY_ID, 'IW'))"/>
      </OutputTables>
    </nodeData>
  </node>
