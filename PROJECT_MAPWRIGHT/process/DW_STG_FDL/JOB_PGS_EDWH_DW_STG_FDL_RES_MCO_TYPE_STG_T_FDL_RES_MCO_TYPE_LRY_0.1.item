      </InputTables>
      <OutputTables name="STG_T_FDL_RES_MCO_TYPE_LRY" tableName="STG_T_FDL_RES_MCO_TYPE_LRY">
        <DBMapperTableEntries name="SYS_SRC_ID" expression="S.SYS_SRC_ID"/>
        <DBMapperTableEntries name="INSERT_DTTM" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUN_ID" expression="NULL"/>
        <DBMapperTableEntries name="MCO_TYPE_CODE" expression="TRIM(S.SSR_CODE)"/>
        <DBMapperTableEntries name="MCO_TYPE_DESC" expression="CASE WHEN TRIM(S.SSR_CODE) = 'GIZ' AND (S.SSR_EXPLANATION IS NULL OR TRIM(S.SSR_EXPLANATION) = '') THEN 'GIZ' ELSE TRIM(S.SSR_EXPLANATION) END"/>
        <DBMapperTableEntries name="MCO_GRP_CODE" expression="TRIM(S.SSR_GROUP)"/>
        <DBMapperTableEntries name="MCO_GRP_DESC" expression="CASE WHEN S.SSR_GROUP = 'BAG' THEN 'Fazla bagaj (XBAG), el bagajı (HBAG) veya ek bagaj (WBAG) gibi hizmetlerin konsolide edildiği gruptur' WHEN S.SSR_GROUP = 'CATERING' THEN 'Uçuş öncesi sipariş edilen yemek ve içecek (Pre-order meal) hizmetlerini kapsar.' WHEN S.SSR_GROUP = 'DCS' THEN 'Havalimanı check-in bedeli olarak bilinen ve QC koduyla takip edilen operasyonel geliri ifade eder.' WHEN S.SSR_GROUP = 'EQP' THEN 'Spor ekipmanları (Golf, Kayak vb.) gibi özel taşıma gerektiren yan hizmetlerin grubudur.' WHEN S.SSR_GROUP = 'OTH' THEN 'Ana kategorilere girmeyen; IFE, FLEX veya cezai işlemler gibi çeşitli hizmetlerin fallback grubudur.' WHEN S.SSR_GROUP = 'SEAT' THEN 'Koltuk seçimi ve ekstra diz mesafeli koltuklar (EX - Exit) gibi koltuk bazlı hizmetleri temsil eder.' WHEN S.SSR_GROUP = 'WCH' THEN 'Tekerlekli sandalye yardım hizmetlerini (WCHC, WCHR, WCHS) ifade eder.' ELSE NULL END"/>
      </OutputTables>
    </nodeData>
