      <OutputTables name="EXP_C1" tableName="EXP_C1">
        <DBMapperTableEntries name="REPORTINGDATE" expression="A.REPORTINGDATE"/>
        <DBMapperTableEntries name="CUSTOMER" expression="SUBSTR(A.ACCOUNTNUMBER, INSTR(A.ACCOUNTNUMBER, '/') + 1, INSTR(SUBSTR(A.ACCOUNTNUMBER, INSTR(A.ACCOUNTNUMBER, '/') + 1), '/') - 1)"/>
        <DBMapperTableEntries name="INSTRUMENT" expression="A.INSTRUMENTCODE"/>
        <DBMapperTableEntries name="AMOUNT" expression="SUM(CAST(A.TRADEDAMOUNT AS NUMBER(30, 6)))"/>
        <DBMapperTableEntries name="AMOUNTXPRICE" expression="SUM(CAST(A.TRADEDAMOUNT AS NUMBER(30, 6)) * CAST(A.PRICE AS NUMBER(19, 4)))"/>
        <DBMapperTableEntries name="ACCOUNTCURRENCY" expression="A.ACCOUNTCURRENCY"/>
        <FilterEntries name="where" expression="A.REPORTINGDATE >= TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') AND A.REPORTINGDATE &lt; TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') + 1" filterKind="WHERE_CLAUSE"/>
        <FilterEntries name="other" expression="GROUP BY A.REPORTINGDATE, A.INSTRUMENTCODE, A.ACCOUNTCURRENCY, SUBSTR(A.ACCOUNTNUMBER, INSTR(A.ACCOUNTNUMBER, '/') + 1, INSTR(SUBSTR(A.ACCOUNTNUMBER, INSTR(A.ACCOUNTNUMBER, '/') + 1), '/') - 1)" filterKind="OTHER_FILTER"/>
      </OutputTables>
