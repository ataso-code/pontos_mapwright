        <FilterEntries name="other" expression="GROUP BY A1.REPORTINGDATE, A1.INSTRUMENTCODE, A1.ACCOUNTCURRENCY, SUBSTR(A1.ACCOUNTNUMBER, INSTR(A1.ACCOUNTNUMBER, '/') + 1, INSTR(SUBSTR(A1.ACCOUNTNUMBER, INSTR(A1.ACCOUNTNUMBER, '/') + 1), '/') - 1)" filterKind="OTHER_FILTER"/>
