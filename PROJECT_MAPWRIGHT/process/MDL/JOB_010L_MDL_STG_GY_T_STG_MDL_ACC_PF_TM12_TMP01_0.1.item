      <column key="false" length="38" name="AOCOSTPRICE" nullable="true" precision="10" sourceType="NUMBER" type="id_BigDecimal" usefulColumn="true"/>
    </metadata>
    <nodeData xsi:type="TalendDBMap:DBMapData">
      <InputTables name="EXP_C1" tableName="EXP_C1" joinType="NO_JOIN" alias="EXP_C1">
        <DBMapperTableEntries name="REPORTINGDATE"/>
        <DBMapperTableEntries name="CUSTOMER"/>
        <DBMapperTableEntries name="INSTRUMENT"/>
        <DBMapperTableEntries name="AMOUNT"/>
        <DBMapperTableEntries name="AMOUNTXPRICE"/>
        <DBMapperTableEntries name="ACCOUNTCURRENCY"/>
      </InputTables>
      <InputTables name="EXP_C2" tableName="EXP_C2" joinType="INNER_JOIN" alias="EXP_C2">
        <DBMapperTableEntries name="REPORTINGDATE"/>
        <DBMapperTableEntries name="CUSTOMER" expression="EXP_C1.CUSTOMER" join="true" operator="="/>
        <DBMapperTableEntries name="INSTRUMENT" expression="EXP_C1.INSTRUMENT" join="true" operator="="/>
        <DBMapperTableEntries name="AMOUNT"/>
        <DBMapperTableEntries name="AMOUNTXPRICE"/>
        <DBMapperTableEntries name="ACCOUNTCURRENCY" expression="EXP_C1.ACCOUNTCURRENCY" join="true" operator="="/>
      </InputTables>
      <OutputTables name="EXP_P" tableName="EXP_P">
        <DBMapperTableEntries name="REPORTINGDATE" expression="EXP_C1.REPORTINGDATE"/>
        <DBMapperTableEntries name="CUSTOMER" expression="EXP_C1.CUSTOMER"/>
        <DBMapperTableEntries name="INSTRUMENT" expression="EXP_C1.INSTRUMENT"/>
        <DBMapperTableEntries name="BALANCE" expression="SUM(EXP_C2.AMOUNT)"/>
        <DBMapperTableEntries name="ACCOUNTCURRENCY" expression="EXP_C1.ACCOUNTCURRENCY"/>
        <DBMapperTableEntries name="AOCOSTPRICE" expression="CASE WHEN SUM(EXP_C2.AMOUNT) &lt;> 0 THEN SUM(EXP_C2.AMOUNTXPRICE) / SUM(EXP_C2.AMOUNT) ELSE 0 END"/>
        <FilterEntries name="where" expression="TRUNC(EXP_C1.REPORTINGDATE) >= TRUNC(EXP_C2.REPORTINGDATE)" filterKind="WHERE_CLAUSE"/>
        <FilterEntries name="other" expression="GROUP BY EXP_C1.REPORTINGDATE, EXP_C1.CUSTOMER, EXP_C1.INSTRUMENT, EXP_C1.ACCOUNTCURRENCY" filterKind="OTHER_FILTER"/>
      </OutputTables>
    </nodeData>
