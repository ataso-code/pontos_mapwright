        <DBMapperTableEntries name="DWH_SOURCE_CODE" expression="'GTP'"/>
        <DBMapperTableEntries name="INSERT_TIMESTAMP" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUNID" expression="NULL"/>
        <DBMapperTableEntries name="EVENT_ID" expression="ETH.TRANSACTION_ID || '~30019'"/>
        <DBMapperTableEntries name="EVENT_CODE" expression="ETH.TRANSACTION_ID"/>
        <DBMapperTableEntries name="EVENT_CLS_ID" expression="CASE WHEN EXP_WFI.FIN_INST_ID IS NULL AND ETH.DEBIT_CREDIT = 'CREDIT' THEN 'EQBUYCANCEL~40004' WHEN EXP_WFI.FIN_INST_ID IS NULL AND ETH.DEBIT_CREDIT = 'DEBIT' THEN 'EQSELLCANCEL~40004' WHEN NOT EXP_WFI.FIN_INST_ID IS NULL AND ETH.DEBIT_CREDIT = 'DEBIT' THEN 'WARSELLCANCEL~40004' WHEN NOT EXP_WFI.FIN_INST_ID IS NULL AND ETH.DEBIT_CREDIT = 'CREDIT' THEN 'WARBUYCANCEL~40004' WHEN EXP_WFI.FIN_INST_ID IS NULL AND ETH.DEBIT_CREDIT = 'DEBIT' AND ETH.SHORTFALL = 1 THEN 'EQSHORTSELLCANCEL~40004' ELSE '-1' END"/>
        <DBMapperTableEntries name="ACC_ID" expression="ETH.ACCOUNT_ID || '~30003'"/>
        <DBMapperTableEntries name="CNL_ID" expression="ETH.CHANNEL_ID || '~30005'"/>
        <DBMapperTableEntries name="PROD_ID" expression="ETH.FIN_INST_ID || '~30015'"/>
        <DBMapperTableEntries name="POS_ID" expression="ETH.POSTN_ID || '~30014'"/>
        <DBMapperTableEntries name="EVENT_DATE_ID" expression="TO_CHAR(ETH.INITIAL_MARKET_SESSION_DATE, 'YYYYMMDD') || '~20003'"/>
        <DBMapperTableEntries name="VALUE_DATE_ID" expression="TO_CHAR(ETH.SETTLEMENT_DATE, 'YYYYMMDD') || '~20003'"/>
        <DBMapperTableEntries name="UNIT" expression="ETH.UNITS"/>
        <DBMapperTableEntries name="REALIZED_UNIT" expression="NVL(ETH.REALIZED_UNITS, 0)"/>
        <DBMapperTableEntries name="PRICE" expression="NVL(ETH.PRICE, 0)"/>
        <DBMapperTableEntries name="AMOUNT" expression="ETH.AMOUNT"/>
        <DBMapperTableEntries name="FILL_AMOUNT" expression="NVL(ETH.FILL_AMOUNT, 0)"/>
        <DBMapperTableEntries name="AVG_PRICE" expression="NVL(ETH.AVERAGE_PRICE, 0)"/>
        <DBMapperTableEntries name="GROSS_COMM_AMOUNT" expression="NVL(EXP_GROSSCOM.EXPENSE, 0)"/>
        <DBMapperTableEntries name="OTHER_TAX_EXPENSE_RATE" expression="0"/>
        <DBMapperTableEntries name="OTHER_TAX_EXPENSE_AMOUNT" expression="NVL(EXP_TAXAMNT.EXPENSE, 0)"/>
        <DBMapperTableEntries name="MARKET_COMM_RATE" expression="0"/>
        <DBMapperTableEntries name="MARKET_COMM_AMOUNT" expression="0"/>
        <DBMapperTableEntries name="CUSTODIAN_COMM_RATE" expression="0"/>
        <DBMapperTableEntries name="CUSTODIAN_COMM_AMOUNT" expression="0"/>
        <DBMapperTableEntries name="IS_INCLUDE_BMV" expression="-1"/>
        <DBMapperTableEntries name="EVENT_STATUS_ID" expression="NVL(ETH.TRANSACTION_STATUS_ID || '~30021', 0)"/>
        <DBMapperTableEntries name="ORDER_SUB_TP_ID" expression="ETH.TRANSACTION_TYPE_ID || '~30020'"/>
        <DBMapperTableEntries name="EVENT_IP_ADDRESS" expression="NVL(EXP_IPADR.IP_ADDRESS, '10.0.0.0')"/>
        <DBMapperTableEntries name="REQUEST_DATETIME" expression="ETH.CREATED"/>
        <DBMapperTableEntries name="ORDER_DATETIME" expression="TO_TIMESTAMP(TO_CHAR(ETH.ORDER_DATE, 'DD-MM-YYYY') || ' ' || ETH.IMKB_PROCESSING_TIME, 'DD-MM-YYYY HH24:MI:SS')"/>
        <DBMapperTableEntries name="FILLED_DATETIME" expression="TO_TIMESTAMP('01-01-1900 00:00:00', 'DD-MM-YYYY HH24:MI:SS')"/>
        <DBMapperTableEntries name="REALIZED_DATETIME" expression="TO_TIMESTAMP('01-01-1900 00:00:00', 'DD-MM-YYYY HH24:MI:SS')"/>
        <DBMapperTableEntries name="ISE_ORDER_NO" expression="NVL(ETH.ISE_ORDER_NO, -1)"/>
        <DBMapperTableEntries name="EVENT_REF" expression="ETH.TRANSACTION_EXT_ID"/>
        <DBMapperTableEntries name="SEND_USER_POS_ID" expression="ETH.DEST_RECON_POS_ID || '~30014'"/>
        <DBMapperTableEntries name="CANCEL_EXPENSE" expression="NVL(EXP_CANCELCOMM.EXPENSE, 0)"/>
        <DBMapperTableEntries name="OTHER_EXPENSE" expression="NVL(EXP_OTHEREXPENSE.EXPENSE, 0)"/>
        <FilterEntries name="where" expression="ETH.INITIAL_MARKET_SESSION_DATE >= TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') AND ETH.INITIAL_MARKET_SESSION_DATE &lt; TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') + 1 AND (ETH.REALIZED_UNITS IS NULL OR ETH.REALIZED_UNITS = 0)" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
    </nodeData>
  </node>
