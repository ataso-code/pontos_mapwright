        <DBMapperTableEntries name="DWH_SOURCE_CODE" expression="'OMS'"/>
        <DBMapperTableEntries name="INSERT_TIMESTAMP" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUNID" expression="NULL"/>
        <DBMapperTableEntries name="EVENT_ID" expression="CAST(FX.ORDERID AS VARCHAR2(50)) || '-' || CAST(FX.POSITIONID AS VARCHAR2(50)) || '-' || CAST(FX.SIDE AS VARCHAR2(50)) || '-' || DECODE(FX.POSITIONEFFECT, 'O', 'OPEN', 'C', 'CLOSE', 'NA') || '~30019'"/>
        <DBMapperTableEntries name="EVENT_CODE" expression="CAST(FX.ORDERID AS VARCHAR2(50)) || '-' || CAST(FX.POSITIONID AS VARCHAR2(50)) || '-' || CAST(FX.SIDE AS VARCHAR2(50)) || '-' || DECODE(FX.POSITIONEFFECT, 'O', 'OPEN', 'C', 'CLOSE', 'NA')"/>
        <DBMapperTableEntries name="EVENT_CLS_ID" expression="'FX' || DECODE(FX.SIDE, 1, 'S', '2', 'L', 'NA') || DECODE(FX.POSITIONEFFECT, 'O', 'OPEN', 'C', 'CLOSE', 'NA') || '~40004'"/>
        <DBMapperTableEntries name="ACC_ID" expression="CASE WHEN EXP_ACC.ACCOUNT_ID IS NULL THEN '-1' ELSE EXP_ACC.ACCOUNT_ID || '~30003' END"/>
        <DBMapperTableEntries name="ACC_CURR_PROD_ID" expression="CASE WHEN EXP_ACC.ACCOUNT_CURRENCY_ID IS NULL THEN '-1' ELSE EXP_ACC.ACCOUNT_CURRENCY_ID || '~30015' END"/>
        <DBMapperTableEntries name="AMOUNT" expression="FX.QUANTITY * FX.AVGPX * NVL(PLCURRVAL.VALUE9, 1)"/>
        <DBMapperTableEntries name="AMOUNT_OC" expression="FX.QUANTITY * FX.AVGPX"/>
        <DBMapperTableEntries name="CNL_ID" expression="'0000-000001-CHN~30005'"/>
        <DBMapperTableEntries name="PROD_ID" expression="CAST(FX.SYMBOLID AS VARCHAR2(255)) || '~30015'"/>
        <DBMapperTableEntries name="POS_ID" expression="'-99'"/>
        <DBMapperTableEntries name="UNIT" expression="FX.QUANTITY"/>
        <DBMapperTableEntries name="REALIZED_UNIT" expression="FX.QUANTITY"/>
        <DBMapperTableEntries name="PRICE" expression="FX.AVGPX"/>
        <DBMapperTableEntries name="EVENT_DATE_ID" expression="TO_CHAR(FX.PROCESSINGDATE, 'YYYYMMDD') || '~20003'"/>
        <DBMapperTableEntries name="VALUE_DATE_ID" expression="TO_CHAR(FX.SETTLDATE, 'YYYYMMDD') || '~20003'"/>
        <DBMapperTableEntries name="EVENT_IP_ADDRESS" expression="FX.SOURCEIP"/>
        <DBMapperTableEntries name="EVENT_REF" expression="FX.CLIENTORDERID"/>
        <DBMapperTableEntries name="EVENT_STATUS_ID" expression="'2~30021'"/>
        <DBMapperTableEntries name="GROSS_COMM_AMOUNT" expression="NVL(FX.MARKUPUSD, 0) * NVL(PLCURRVAL.VALUE9, 1)"/>
        <DBMapperTableEntries name="GROSS_COMM_AMOUNT_OC" expression="NVL(FX.MARKUPUSD, 0)"/>
        <DBMapperTableEntries name="MARKET_COMM_AMOUNT" expression="0"/>
