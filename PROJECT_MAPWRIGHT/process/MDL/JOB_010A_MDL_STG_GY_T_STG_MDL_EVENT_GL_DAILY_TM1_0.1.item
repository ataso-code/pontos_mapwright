      <OutputTables name="T_STG_MDL_EVENT_GL_DAILY_TM1" tableName="T_STG_MDL_EVENT_GL_DAILY_TM1">
        <DBMapperTableEntries name="ETL_DATE" expression="TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY')"/>
        <DBMapperTableEntries name="DWH_SOURCE_CODE" expression="'GTP'"/>
        <DBMapperTableEntries name="INSERT_TIMESTAMP" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUNID" expression="NULL"/>
        <DBMapperTableEntries name="EVENT_ID" expression="CASE WHEN (GL.DOCUMENT_NO || '~' || GL.POSTING_DATE) = '~' THEN '-1' ELSE GL.DOCUMENT_NO || '~' || TO_CHAR(GL.POSTING_DATE, 'YYYYMMDD') || '~30019' END"/>
        <DBMapperTableEntries name="EVENT_CODE" expression="CASE WHEN (GL.DOCUMENT_NO || '~' || GL.POSTING_DATE) = '~' THEN '?' ELSE GL.DOCUMENT_NO || '~' || TO_CHAR(GL.POSTING_DATE, 'YYYYMMDD') || '~30019' END"/>
        <DBMapperTableEntries name="EVENT_DESC" expression="NVL(GL.DESCRIPTION, '?')"/>
        <DBMapperTableEntries name="REL_EVENT_ID" expression="CASE WHEN GL.TRANSACTION_ID IS NULL THEN '-1' ELSE GL.TRANSACTION_ID || '~30019' END"/>
        <DBMapperTableEntries name="EVENT_CLS_ID" expression="'GLEVENT~40004'"/>
        <DBMapperTableEntries name="CNL_ID" expression="'0000-000001-CHN~30005'"/>
        <DBMapperTableEntries name="COA_ID" expression="CASE WHEN GL.COA_ID IS NULL THEN '-1' ELSE GL.COA_ID || '~30023' END"/>
        <DBMapperTableEntries name="ACC_ID" expression="CASE WHEN GL.ACCOUNT IS NULL THEN '-1' ELSE GL.ACCOUNT || '~30003' END"/>
        <DBMapperTableEntries name="DIV_ID" expression="CASE WHEN GL.ACC_DIVISION IS NULL THEN '-1' ELSE GL.ACC_DIVISION || '~30009' END"/>
        <DBMapperTableEntries name="EVENT_DATE_ID" expression="CASE WHEN GL.POSTING_DATE IS NULL THEN '-1' ELSE TO_CHAR(GL.POSTING_DATE, 'YYYYMMDD') || '~20003' END"/>
        <DBMapperTableEntries name="VALUE_DATE_ID" expression="CASE WHEN GL.POSTING_DATE IS NULL THEN '-1' ELSE TO_CHAR(GL.POSTING_DATE, 'YYYYMMDD') || '~20003' END"/>
        <DBMapperTableEntries name="PROD_ID" expression="CASE WHEN GL.FIN_INST IS NULL THEN '-1' ELSE GL.FIN_INST || '~30015' END"/>
        <DBMapperTableEntries name="CUR_PROD_ID" expression="CASE WHEN GL.CURRENCY_CODE IS NULL THEN '-1' ELSE GL.CURRENCY_CODE || '~30015' END"/>
        <DBMapperTableEntries name="ACC_DEF_PROD_ID" expression="CASE WHEN GL.ACC_DEF_OP_ID IS NULL THEN '-1' ELSE GL.ACC_DEF_OP_ID || '~30026' END"/>
        <DBMapperTableEntries name="VOLUME" expression="NVL(GL.AMOUNT, 0)"/>
        <DBMapperTableEntries name="DOCUMENT_NO" expression="NVL(GL.DOCUMENT_NO, '?')"/>
        <DBMapperTableEntries name="COUNT_NO" expression="NVL(GL.COUNT_NO, 0)"/>
        <DBMapperTableEntries name="CREATED_EMP_ID" expression="CASE WHEN POS.EMP_ID IS NULL THEN '-1' ELSE POS.EMP_ID || '~30010' END"/>
        <FilterEntries name="where" expression="GL.POSTING_DATE >= TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') AND GL.POSTING_DATE &lt; TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') + 1" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
