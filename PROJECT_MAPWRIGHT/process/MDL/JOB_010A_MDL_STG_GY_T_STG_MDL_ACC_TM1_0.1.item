        <DBMapperTableEntries name="CURRENCY_PROD_ID" expression="CASE WHEN A.ACCOUNT_CURRENCY_ID IS NULL THEN '-1' ELSE A.ACCOUNT_CURRENCY_ID || '~30015' END"/>
