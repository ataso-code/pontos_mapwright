        <DBMapperTableEntries name="ACC_CLOSE_DATE" expression="NVL(A.CLOSED, DECODE(A.ACCOUNT_STATUS_ID, '0000-000002-ASD', TRUNC(NVL(A.LAST_UPD, A.CREATED + 1)), TO_DATE('31.12.9999', 'DD.MM.YYYY')))"/>
