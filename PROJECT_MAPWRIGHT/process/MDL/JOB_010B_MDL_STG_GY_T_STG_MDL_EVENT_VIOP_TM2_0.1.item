        <DBMapperTableEntries name="AMOUNT" expression="DTH.AMOUNT"/>
        <DBMapperTableEntries name="FILL_AMOUNT" expression="NVL(FILL.FILL_UNITS * FILL.FILL_PRICE * (FILL.BASIS_PRICE * NVL(FI.UNIT_NOMINAL, 1)), 0)"/>
