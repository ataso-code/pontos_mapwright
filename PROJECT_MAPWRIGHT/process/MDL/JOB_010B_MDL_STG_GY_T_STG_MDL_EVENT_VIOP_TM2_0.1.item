        <DBMapperTableEntries name="REALIZED_DATETIME" expression="CAST(FILL.FILL_TIME AS TIMESTAMP)"/>
        <DBMapperTableEntries name="ORDER_DATE_TP_ID" expression="CASE WHEN DTH.TRANSACTION_DATE_TYPE_ID IS NULL THEN '-1' ELSE DTH.TRANSACTION_DATE_TYPE_ID || '~30022' END"/>
        <DBMapperTableEntries name="EVENT_REF" expression="NVL(DTH.TRANSACTION_EXT_ID, '-99')"/>
        <DBMapperTableEntries name="GROSS_COMM_RATE" expression="0"/>
        <DBMapperTableEntries name="POSITION_CLOSED_UNIT" expression="NVL(FILL.CLOSING_UNITS, 0)"/>
        <DBMapperTableEntries name="ISE_ORDER_NO" expression="NVL(DTH.TD_ORDER_NO, 0)"/>
