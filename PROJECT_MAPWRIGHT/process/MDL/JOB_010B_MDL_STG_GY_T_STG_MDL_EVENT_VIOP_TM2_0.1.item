        <DBMapperTableEntries name="CUSTODIAN_COMM_RATE" expression="0"/>
        <DBMapperTableEntries name="CUSTODIAN_COMM_AMOUNT" expression="0"/>
        <DBMapperTableEntries name="EVENT_STATUS_ID" expression="CASE WHEN DTH.TRANSACTION_STATUS_ID IS NULL THEN '-1' ELSE DTH.TRANSACTION_STATUS_ID || '~30021' END"/>
        <DBMapperTableEntries name="ORDER_SUB_TP_ID" expression="CASE WHEN DTH.TRANSACTION_TYPE_ID IS NULL THEN '-1' ELSE DTH.TRANSACTION_TYPE_ID || '~30020' END"/>
