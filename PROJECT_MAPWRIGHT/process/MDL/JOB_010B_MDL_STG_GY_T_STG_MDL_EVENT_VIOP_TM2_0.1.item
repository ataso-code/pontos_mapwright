        <DBMapperTableEntries name="SEND_USER_POS_ID" expression="CASE WHEN DTH.DEST_RECON_POS_ID IS NULL THEN '-1' ELSE DTH.DEST_RECON_POS_ID || '~30014' END"/>
        <DBMapperTableEntries name="CANCEL_EXPENSE" expression="0"/>
        <DBMapperTableEntries name="OTHER_EXPENSE" expression="0"/>
      </OutputTables>
    </nodeData>
