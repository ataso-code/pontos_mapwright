        <DBMapperTableEntries name="EVENT_CLS_ID" expression="CASE WHEN DTH.DEBIT_CREDIT = 'DEBIT' AND DTH.REALIZED_UNITS > 0 THEN 'FUTSHORT~40004' ELSE 'FUTLONG~40004' END"/>
