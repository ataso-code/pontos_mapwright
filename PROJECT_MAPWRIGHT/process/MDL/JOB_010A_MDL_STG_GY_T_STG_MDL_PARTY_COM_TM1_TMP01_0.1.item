      <InputTables name="DGYTMDL.T_MDL_PARTY" tableName="DGYTMDL.T_MDL_PARTY" joinType="INNER_JOIN" alias="GEN">
        <DBMapperTableEntries name="DWH_VALID_FROM"/>
        <DBMapperTableEntries name="DWH_VALID_UNTIL"/>
        <DBMapperTableEntries name="DWH_STATUS"/>
