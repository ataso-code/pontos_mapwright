        <DBMapperTableEntries name="UPDATE_TIMESTAMP"/>
        <DBMapperTableEntries name="UPDATE_RUNID"/>
        <DBMapperTableEntries name="PARTY_ID"/>
        <DBMapperTableEntries name="RELATED_PARTY_ID"/>
        <DBMapperTableEntries name="PARTY_REL_ROLE_ID"/>
        <DBMapperTableEntries name="PARTY_REL_RSN_ID"/>
        <DBMapperTableEntries name="START_DATE"/>
        <DBMapperTableEntries name="END_DATE"/>
      </InputTables>
      <OutputTables name="EXP_REL" tableName="EXP_REL">
        <DBMapperTableEntries name="PARTY_ID" expression="PR.PARTY_ID"/>
        <DBMapperTableEntries name="RELATED_PARTY_ID" expression="PR.RELATED_PARTY_ID"/>
        <DBMapperTableEntries name="START_DATE" expression="PR.START_DATE"/>
        <DBMapperTableEntries name="END_DATE" expression="PR.END_DATE"/>
        <DBMapperTableEntries name="RN" expression="ROW_NUMBER() OVER (PARTITION BY PR.RELATED_PARTY_ID ORDER BY PR.END_DATE DESC, PR.START_DATE DESC, CASE WHEN PR.PARTY_ID LIKE '%~10007' THEN 1 ELSE 2 END, PR.PARTY_ID)"/>
        <FilterEntries name="where" expression="PR.DWH_STATUS = 1 AND PR.PARTY_REL_ROLE_ID = 'MARS2CON~40012'" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
    </nodeData>
