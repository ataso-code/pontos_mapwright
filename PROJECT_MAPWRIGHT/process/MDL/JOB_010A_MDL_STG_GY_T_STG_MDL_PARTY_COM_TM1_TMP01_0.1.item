      </InputTables>
      <OutputTables name="T_STG_MDL_PARTY_COM_TM1_TMP01" tableName="T_STG_MDL_PARTY_COM_TM1_TMP01">
        <DBMapperTableEntries name="ETL_DATE" expression="TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY')"/>
        <DBMapperTableEntries name="DWH_SOURCE_CODE" expression="'GEN'"/>
        <DBMapperTableEntries name="INSERT_TIMESTAMP" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUNID" expression="NULL"/>
        <DBMapperTableEntries name="PARTY_ID" expression="EXP_REL.RELATED_PARTY_ID"/>
        <DBMapperTableEntries name="MARS_PARTY_ID" expression="EXP_REL.PARTY_ID"/>
        <DBMapperTableEntries name="TP" expression="CASE WHEN EXP_REL.RELATED_PARTY_ID LIKE '%-CON~%' THEN 'P' WHEN EXP_REL.RELATED_PARTY_ID LIKE '%-INS~%' THEN 'C' ELSE 'NA' END"/>
        <FilterEntries name="where" expression="(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN GEN.DWH_VALID_FROM AND GEN.DWH_VALID_UNTIL) AND (GEN.DWH_SOURCE_CODE = 'GEN') AND (EXP_REL.RN = 1)" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
    </nodeData>
