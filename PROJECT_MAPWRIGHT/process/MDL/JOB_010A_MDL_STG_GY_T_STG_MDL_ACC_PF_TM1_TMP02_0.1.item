        <DBMapperTableEntries name="FIN_INST_ID" expression="STOC.FIN_INST_ID"/>
        <DBMapperTableEntries name="AO_COST_PRICE" expression="CASE WHEN SUM(STOC.NOMINAL) = 0 THEN 0 ELSE SUM(STOC.NOMINAL * STOC.PRICE) / SUM(STOC.NOMINAL) END"/>
        <DBMapperTableEntries name="FIFO_COST_PRICE" expression="CASE WHEN SUM(STOC.REMAINING) = 0 THEN 0 ELSE SUM(STOC.REMAINING * STOC.PRICE) / SUM(STOC.REMAINING) END"/>
        <FilterEntries name="where" expression="INS.FIN_INST_TYPE_ID = '0000-000001-FIT' AND STOC.AMOUNT > 0 AND STOC.VALUE_DATE >= TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') AND STOC.VALUE_DATE &lt; TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') + 1" filterKind="WHERE_CLAUSE"/>
        <FilterEntries name="other" expression="GROUP BY STOC.CUSTOMER_ID, STOC.VALUE_DATE, STOC.FIN_INST_ID" filterKind="OTHER_FILTER"/>
      </OutputTables>
    </nodeData>
