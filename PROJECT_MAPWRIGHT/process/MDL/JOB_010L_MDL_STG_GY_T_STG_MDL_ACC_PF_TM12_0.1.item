        <DBMapperTableEntries name="FIFO_COST_PRICE" expression="0"/>
        <DBMapperTableEntries name="MARKET_PRICE" expression="NVL(POS.EODRate, 0)"/>
        <DBMapperTableEntries name="MARKET_CAP" expression="NVL(PRI.Balance * POS.EODRate, 0)"/>
        <DBMapperTableEntries name="MKK_BLOCKAGE" expression="0"/>
        <DBMapperTableEntries name="COLLATERAL_RATE" expression="0"/>
        <DBMapperTableEntries name="COLLATERAL_AMOUNT" expression="0"/>
        <DBMapperTableEntries name="FIFO_POTENTIAL_PROFIT" expression="0"/>
        <DBMapperTableEntries name="AO_POTENTIAL_PROFIT" expression="NVL(PRI.Balance * (PRI.AOCostPrice - POS.EODRate), 0)"/>
        <DBMapperTableEntries name="COLLATERAL_BASE_CREDIT" expression="0"/>
        <DBMapperTableEntries name="MAXIMUM_CREDIT" expression="0"/>
        <DBMapperTableEntries name="REMAIN_CREDIT_AMOUNT" expression="0"/>
        <DBMapperTableEntries name="VOLUME" expression="NVL(PRI.Balance * PRI.AOCostPrice * POS.FigureSize, 0)"/>
