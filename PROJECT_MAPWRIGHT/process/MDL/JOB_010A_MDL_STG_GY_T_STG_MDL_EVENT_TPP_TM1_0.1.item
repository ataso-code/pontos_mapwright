      <OutputTables name="T_STG_MDL_EVENT_TPP_TM1" tableName="T_STG_MDL_EVENT_TPP_TM1">
        <DBMapperTableEntries name="ETL_DATE" expression="TRUNC(TR.VALUE_DATE)"/>
        <DBMapperTableEntries name="DWH_SOURCE_CODE" expression="'GTP'"/>
        <DBMapperTableEntries name="INSERT_TIMESTAMP" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUNID" expression="NULL"/>
        <DBMapperTableEntries name="EVENT_ID" expression="CASE WHEN TR.TRANSACTION_ID IS NULL THEN '-1' ELSE TR.TRANSACTION_ID || '~30019' END"/>
        <DBMapperTableEntries name="EVENT_CODE" expression="NVL(TR.TRANSACTION_ID, '?')"/>
        <DBMapperTableEntries name="EVENT_CLS_ID" expression="DECODE(TR.DEBIT_CREDIT, 'DEBIT', 'TPPBUY~40004', 'CREDIT', 'TPPSELL~40004')"/>
        <DBMapperTableEntries name="ACC_ID" expression="CASE WHEN TR.ACCOUNT_ID IS NULL THEN '-1' ELSE TR.ACCOUNT_ID || '~30003' END"/>
        <DBMapperTableEntries name="CNL_ID" expression="CASE WHEN TR.CHANNEL_ID IS NULL THEN '-99' ELSE TR.CHANNEL_ID || '~30005' END"/>
        <DBMapperTableEntries name="PROD_ID" expression="CASE WHEN TR.FIN_INST_ID IS NULL THEN '-1' ELSE TR.FIN_INST_ID || '~30005' END"/>
        <DBMapperTableEntries name="POS_ID" expression="CASE WHEN TR.POSTN_ID IS NULL THEN '-99' ELSE TR.POSTN_ID || '~30014' END"/>
        <DBMapperTableEntries name="EVENT_DATE_ID" expression="NVL(TO_CHAR(TR.VALUE_DATE, 'YYYYMMDD') || '~20003', '?')"/>
        <DBMapperTableEntries name="MATURITY_DATE_ID" expression="NVL(TO_CHAR(TR.MATURITY_DATE, 'YYYYMMDD') || '~20003', '?')"/>
        <DBMapperTableEntries name="AMOUNT" expression="NVL(TR.PRINCIPAL, 0)"/>
        <DBMapperTableEntries name="MATURITY_AMOUNT" expression="NVL(TR.MATURITY_AMOUNT, 0)"/>
        <DBMapperTableEntries name="REMAINING_AMOUNT" expression="NVL(TR.REMAINING_PRINCIPAL, 0)"/>
        <DBMapperTableEntries name="REMAINING_MATURITY_AMOUNT" expression="NVL(TR.REMAINING_MATURITY_AMOUNT, 0)"/>
        <DBMapperTableEntries name="INTEREST_RATE" expression="NVL(TR.RATE, 0)"/>
        <DBMapperTableEntries name="COMM_RATE" expression="NVL(TR.COMMISSION_RATE, 0)"/>
        <DBMapperTableEntries name="COMM_AMOUNT" expression="NVL(TR.COMMISSION_AMOUNT, 0)"/>
        <DBMapperTableEntries name="STOPPAGE_AMOUNT" expression="NVL(TR.STOPPAGE, 0)"/>
        <DBMapperTableEntries name="EVENT_STATUS_ID" expression="CASE WHEN TR.TRANSACTION_STATUS_ID IS NULL THEN '-1' ELSE TR.TRANSACTION_STATUS_ID || '~30021' END"/>
        <DBMapperTableEntries name="EVENT_IP_ADDRESS" expression="'0.0.0.0'"/>
        <DBMapperTableEntries name="REQUEST_DATETIME" expression="NVL(TR.CREATED, TO_DATE('01.01.1900', 'DD.MM.YYYY'))"/>
        <FilterEntries name="where" expression="TR.TRANSACTION_STATUS_ID = '0000-000002-MSD'" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
