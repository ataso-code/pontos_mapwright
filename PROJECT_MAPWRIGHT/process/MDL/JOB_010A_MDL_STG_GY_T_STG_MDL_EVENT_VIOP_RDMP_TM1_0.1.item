        <DBMapperTableEntries name="UNIT_NOMINAL" expression="NVL(EXP_CHTS.UNIT_NOMINAL, 0)"/>
        <DBMapperTableEntries name="LONG_BALANCE" expression="REDEMP.LONG_BALANCE"/>
        <DBMapperTableEntries name="SHORT_BALANCE" expression="REDEMP.SHORT_BALANCE"/>
        <DBMapperTableEntries name="REDEMPT_PRICE" expression="NVL(REDEMP.REDEMPTION_PRICE, 0) * NVL(VH.VALUE9, 1)"/>
        <DBMapperTableEntries name="STRIKE_PRICE" expression="EXP_CHTS.STRIKE_PRICE * NVL(VH.VALUE9, 1)"/>
        <DBMapperTableEntries name="GROSS_COMM_AMOUNT" expression="NVL(EXPENSE.EXPENSE, 0)"/>
        <DBMapperTableEntries name="OTHER_TAX_EXPENSE_RATE" expression="0"/>
        <DBMapperTableEntries name="OTHER_TAX_EXPENSE_AMOUNT" expression="NVL(TAX.EXPENSE, 0)"/>
        <DBMapperTableEntries name="MARKET_COMM_RATE" expression="0"/>
        <DBMapperTableEntries name="MARKET_COMM_AMOUNT" expression="0"/>
        <DBMapperTableEntries name="CUSTODIAN_COMM_RATE" expression="0"/>
        <DBMapperTableEntries name="CUSTODIAN_COMM_AMOUNT" expression="0"/>
        <DBMapperTableEntries name="EVENT_STATUS_ID" expression="'-99'"/>
        <DBMapperTableEntries name="ORDER_SUB_TP_ID" expression="'-99'"/>
        <DBMapperTableEntries name="EVENT_IP_ADDRESS" expression="'-99'"/>
        <DBMapperTableEntries name="REQUEST_DATETIME" expression="TRUNC(REDEMP.CREATED)"/>
        <DBMapperTableEntries name="ORDER_DATETIME" expression="TRUNC(REDEMP.CREATED)"/>
        <DBMapperTableEntries name="FILLED_DATETIME" expression="TRUNC(NVL(REDEMP.LAST_UPD, REDEMP.CREATED))"/>
        <DBMapperTableEntries name="REALIZED_DATETIME" expression="TRUNC(NVL(REDEMP.LAST_UPD, REDEMP.CREATED))"/>
