        <DBMapperTableEntries name="EVENT_ID" expression="REDEMP.REDEMPTION_DATE || SUBSTR(REDEMP.ACCOUNT_ID, 6, 6) || SUBSTR(REDEMP.FIN_INST_ID, 6, 6) || SUBSTR(REDEMP.BOOKING_REF, 6, 6) || '~30019'"/>
        <DBMapperTableEntries name="EVENT_CODE" expression="REDEMP.REDEMPTION_DATE || SUBSTR(REDEMP.ACCOUNT_ID, 6, 6) || SUBSTR(REDEMP.FIN_INST_ID, 6, 6) || SUBSTR(REDEMP.BOOKING_REF, 6, 6)"/>
        <DBMapperTableEntries name="EVENT_CLS_ID" expression="CASE WHEN REDEMP.LONG_BALANCE > REDEMP.SHORT_BALANCE THEN 'OPTLONGREDEM~40004' ELSE 'OPTSHORTREDEM~40004' END"/>
        <DBMapperTableEntries name="ACC_ID" expression="CASE WHEN REDEMP.ACCOUNT_ID IS NULL THEN '-1' ELSE REDEMP.ACCOUNT_ID || '~30003' END"/>
        <DBMapperTableEntries name="PROD_ID" expression="CASE WHEN REDEMP.FIN_INST_ID IS NULL THEN '-1' ELSE REDEMP.FIN_INST_ID || '~30015' END"/>
