        <FilterEntries name="other" expression="GROUP BY A.REPORTINGDATE, A.FIGURESIZE, A.EODRATE, SUBSTR(A.ACCOUNTNUMBER, INSTR(A.ACCOUNTNUMBER, '/') + 1, INSTR(SUBSTR(A.ACCOUNTNUMBER, INSTR(A.ACCOUNTNUMBER, '/') + 1), '/') - 1), A.INSTRUMENTCODE, A.ACCOUNTCURRENCY" filterKind="OTHER_FILTER"/>
