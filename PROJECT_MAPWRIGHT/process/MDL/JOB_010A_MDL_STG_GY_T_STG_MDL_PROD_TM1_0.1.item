        <DBMapperTableEntries name="UPDATE_RUNID" expression="NULL"/>
        <DBMapperTableEntries name="PROD_ID" expression="EXP_FIN.FIN_INST_ID || '~30015'"/>
        <DBMapperTableEntries name="PROD_CODE" expression="EXP_FIN.FIN_INST_ID"/>
        <DBMapperTableEntries name="PROD_NAME" expression="NVL(EXP_FIN.name, '?')"/>
        <DBMapperTableEntries name="PROD_DESC" expression="NVL(EXP_FIN.DESCRIPTION, '?')"/>
        <DBMapperTableEntries name="PROD_TP_ID" expression="CASE WHEN EXP_FIN.MARKET_CODE = '#NA' THEN EXP_FIN.FIN_INST_TYPE_ID || '~30016' ELSE EXP_FIN.MARKET_CODE || '~30016' END"/>
        <DBMapperTableEntries name="PROD_CLS_ID" expression="CASE WHEN EQ.GROUP_CODE = 'V' THEN 'WAR~30017' WHEN EQ.GROUP_CODE &lt;> 'V' AND EXP_FIN.MARKET_CODE = '#NA' THEN 'EQ~30017' WHEN EQ.GROUP_CODE &lt;> 'V' AND EXP_FIN.MARKET_CODE &lt;> '#NA' THEN 'EQ_INT~30017' WHEN EQ.GROUP_CODE IS NULL AND EXP_FIN.FIN_INST_TYPE_ID = '0000-000001-FIT' THEN 'EQF~30017' WHEN EXP_FIN.FIN_INST_TYPE_ID = '0000-00000A-FIT' AND FUT.FIN_INST_ID IS NULL THEN 'FUTF~30017' WHEN EXP_FIN.FIN_INST_TYPE_ID = '0000-00000A-FIT' AND NOT FUT.FIN_INST_ID IS NULL THEN 'FUT~30017' ELSE '-1' END"/>
        <DBMapperTableEntries name="CURRENCY_PROD_ID" expression="CASE WHEN EXP_FIN.CURRENCY_ID IS NULL THEN '-1' ELSE EXP_FIN.CURRENCY_ID || '~30015' END"/>
      </OutputTables>
