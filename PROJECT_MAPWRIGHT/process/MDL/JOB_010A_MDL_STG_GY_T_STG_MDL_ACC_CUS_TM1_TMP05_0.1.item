        <DBMapperTableEntries name="ACC_CLOSE_DESC" expression="BRK.ACC_CLOSE_DESC"/>
        <DBMapperTableEntries name="RN" expression="ROW_NUMBER() OVER (PARTITION BY RELMARS.PARTY_ID, ACC.CUS_PARTY_ID ORDER BY CASE WHEN TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN TRUNC(ACC.ACC_OPEN_DATE) AND CASE WHEN REPLACE(UPPER(TRANSLATE(BRK.ACC_CLOSE_DESC, 'ÇĞİÖŞÜçğıöşü', 'CGIOSUcgiosu')), ' ', '') LIKE '%SUBEDEVRI%' THEN TRUNC(ACC.ACC_CLOSE_DATE) - 1 ELSE TRUNC(ACC.ACC_CLOSE_DATE) END THEN 0 ELSE 1 END, CASE WHEN TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') > TRUNC(ACC.ACC_CLOSE_DATE) THEN 0 ELSE 1 END, DECODE(ASTT.ACC_STATUS_NAME, 'ACTIVE', 1, 'ALL_TRANS_BLOCKAGE', 2, 'WITHOUT_TRANSACTIONS', 3, 'CONTRACT_APPROVE', 4, 'OUT_BLOCKAGE', 5, 'CLOSED', 99, 100), CASE WHEN CAST(DIV.DIV_CODE AS INT) IN (0, 1, 2, 3, 4, 5) THEN 3 WHEN CAST(DIV.DIV_CODE AS INT) = 6 THEN 2 WHEN CAST(DIV.DIV_CODE AS INT) = 7 THEN 1 ELSE 0 END, DECODE(BRK.BRK_ACC_CLS_ID, 'TUM~40002', 1, 'VIOP~40002', 2, 'INT~40002', 3, 'FX~40002', 4, 5), ACC.ACC_OPEN_DATE, ACC.ACC_CLOSE_DATE DESC, ACC.ACC_NUMBER)"/>
        <DBMapperTableEntries name="MARS_STATUS" expression="EXP_MSTT.MARS_STATUS"/>
        <FilterEntries name="where" expression="(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN CUS.DWH_VALID_FROM AND CUS.DWH_VALID_UNTIL) AND (TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN EXP_RELCON.START_DATE AND EXP_RELCON.END_DATE) AND (EXP_RELCON.PARTY_REL_ROLE_ID = 'CON2CUS~40012') AND (TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN ACC.DWH_VALID_FROM AND ACC.DWH_VALID_UNTIL) AND (TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN BRK.DWH_VALID_FROM AND BRK.DWH_VALID_UNTIL) AND (TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN DIV.DWH_VALID_FROM AND DIV.DWH_VALID_UNTIL) AND (DIV.DWH_SOURCE_CODE = 'GTP')" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
    </nodeData>
