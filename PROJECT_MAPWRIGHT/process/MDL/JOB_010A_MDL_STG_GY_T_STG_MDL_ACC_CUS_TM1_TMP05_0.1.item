        <DBMapperTableEntries name="CUS_PARTY_ID" expression="EXP_SRC.CUS_PARTY_ID"/>
        <DBMapperTableEntries name="BRANCH_PARTY_ID" expression="EXP_SRC.BRANCH_PARTY_ID"/>
        <DBMapperTableEntries name="IS_DIV_CUS" expression="CASE WHEN CAST(EXP_SRC.DIV_CODE AS INT) > 7 THEN 1 WHEN CAST(EXP_SRC.DIV_CODE AS INT) IN (1, 2, 3, 4, 5) THEN -1 ELSE 0 END"/>
        <DBMapperTableEntries name="IS_ADK_CUS" expression="CASE WHEN CAST(EXP_SRC.DIV_CODE AS INT) IN (6, 7) THEN 1 WHEN CAST(EXP_SRC.DIV_CODE AS INT) IN (1, 2, 3, 4, 5) THEN -1 ELSE 0 END"/>
        <DBMapperTableEntries name="DIV_REL_DATE" expression="EXP_SRC.ACC_OPEN_DATE"/>
        <DBMapperTableEntries name="MARS_STATUS" expression="EXP_SRC.MARS_STATUS"/>
        <DBMapperTableEntries name="RN_UNIQ_FILTER" expression="ROW_NUMBER() OVER (PARTITION BY EXP_SRC.MARS_PARTY_ID ORDER BY CASE WHEN TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN TRUNC(EXP_SRC.ACC_OPEN_DATE) AND CASE WHEN REPLACE(UPPER(TRANSLATE(EXP_SRC.ACC_CLOSE_DESC, 'ÇĞİÖŞÜçğıöşü', 'CGIOSUcgiosu')), ' ', '') LIKE '%SUBEDEVRI%' THEN TRUNC(EXP_SRC.ACC_CLOSE_DATE) - 1 ELSE TRUNC(EXP_SRC.ACC_CLOSE_DATE) END THEN 0 ELSE 1 END, CASE WHEN TRUNC(EXP_SRC.ACC_CLOSE_DATE) = TRUNC(EXP_SRC.ACC_OPEN_DATE) THEN 1 ELSE 0 END, CASE WHEN TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') > TRUNC(EXP_SRC.ACC_CLOSE_DATE) THEN 0 ELSE 1 END, DECODE(EXP_SRC.ACC_STATUS_NAME, 'ACTIVE', 1, 'ALL_TRANS_BLOCKAGE', 2, 'WITHOUT_TRANSACTIONS', 3, 'CONTRACT_APPROVE', 4, 'OUT_BLOCKAGE', 5, 'CLOSED', 99, 100), CASE WHEN CAST(EXP_SRC.DIV_CODE AS INT) IN (0, 1, 2, 3, 4, 5) THEN 2 WHEN CAST(EXP_SRC.DIV_CODE AS INT) IN (6, 7) THEN 1 ELSE 0 END, DECODE(EXP_SRC.BRK_ACC_CLS_ID, 'TUM~40002', 1, 'VIOP~40002', 2, 'INT~40002', 3, 'FX~40002', 4, 5), EXP_SRC.ACC_OPEN_DATE, EXP_SRC.ACC_CLOSE_DATE DESC, EXP_SRC.ACC_NUMBER)"/>
        <DBMapperTableEntries name="RN" expression="EXP_SRC.RN"/>
      </OutputTables>
    </nodeData>
  </node>
