        <DBMapperTableEntries name="MARS_PARTY_ID" expression="RELMARS.PARTY_ID"/>
        <DBMapperTableEntries name="ACC_NUMBER" expression="ACC.ACC_NUMBER"/>
        <DBMapperTableEntries name="ACC_CLOSE_DATE" expression="ACC.ACC_CLOSE_DATE"/>
