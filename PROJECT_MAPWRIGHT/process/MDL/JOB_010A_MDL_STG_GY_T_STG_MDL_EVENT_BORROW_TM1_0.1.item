      <OutputTables name="T_STG_MDL_EVENT_BORROW_TM1" tableName="T_STG_MDL_EVENT_BORROW_TM1">
        <DBMapperTableEntries name="ETL_DATE" expression="BR.ETL_DATE"/>
        <DBMapperTableEntries name="DWH_SOURCE_CODE" expression="'MNL'"/>
        <DBMapperTableEntries name="INSERT_TIMESTAMP" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUNID" expression="NULL"/>
        <DBMapperTableEntries name="EVENT_ID" expression="TO_CHAR(BR.DATA_DATE, 'YYYYMMDD') || BR.GTP_NUMBER || BR.UNDERLYING || '~30019'"/>
        <DBMapperTableEntries name="EVENT_CODE" expression="TO_CHAR(BR.DATA_DATE, 'YYYYMMDD') || BR.GTP_NUMBER || BR.UNDERLYING"/>
        <DBMapperTableEntries name="EVENT_CLS_ID" expression="'BORROW~40004'"/>
        <DBMapperTableEntries name="CUS_ID" expression="CASE WHEN CUS.CUSTOMER_ID IS NULL THEN '-1' ELSE CUS.CUSTOMER_ID || '~30007' END"/>
        <DBMapperTableEntries name="PROD_ID" expression="CASE WHEN FI.FIN_INST_ID IS NULL THEN '-1' ELSE FI.FIN_INST_ID || '~30015' END"/>
        <DBMapperTableEntries name="POS_ID" expression="CASE WHEN POS.POSTN_ID IS NULL THEN '-1' ELSE POS.POSTN_ID || '~30014' END"/>
        <DBMapperTableEntries name="DIV_ID" expression="CASE WHEN DIV.DIV_ID IS NULL THEN '-1' ELSE DIV.DIV_ID || '~30009' END"/>
        <DBMapperTableEntries name="EVENT_DATE_ID" expression="TO_CHAR(BR.ETL_DATE, 'YYYYMMDD') || '~20003'"/>
        <DBMapperTableEntries name="VALUE_START_DATE_ID" expression="TO_CHAR(BR.ETL_DATE, 'YYYYMMDD') || '~20003'"/>
        <DBMapperTableEntries name="VALUE_END_DATE_ID" expression="TO_CHAR(BR.ETL_DATE + 1, 'YYYYMMDD') || '~20003'"/>
        <DBMapperTableEntries name="UNIT" expression="BR.UNIT"/>
        <DBMapperTableEntries name="AVG_PRICE" expression="EXP_VH.VALUE7"/>
        <DBMapperTableEntries name="AMOUNT" expression="BR.UNIT * EXP_VH.VALUE7"/>
        <DBMapperTableEntries name="OPERATION_COMM_RATE" expression="(BR.OPERATION_COMMISION_RATE / 365)"/>
        <DBMapperTableEntries name="OPERATION_COMM_AMOUNT" expression="(BR.OPERATION_COMMISION_RATE / 365) * BR.UNIT * EXP_VH.VALUE7"/>
        <DBMapperTableEntries name="CUSTOMER_COMM_RATE" expression="(BR.CUSTOMER_COMMISION_RATE / 365)"/>
        <DBMapperTableEntries name="CUSTOMER_COMM_AMOUNT" expression="(BR.CUSTOMER_COMMISION_RATE / 365) * BR.UNIT * EXP_VH.VALUE7"/>
        <DBMapperTableEntries name="DIVISION_COMM_RATE" expression="(BR.OPERATION_COMMISION_RATE - BR.CUSTOMER_COMMISION_RATE) / 365"/>
        <DBMapperTableEntries name="DIVISION_COMM_AMOUNT" expression="((BR.OPERATION_COMMISION_RATE - BR.CUSTOMER_COMMISION_RATE) / 365) * BR.UNIT * EXP_VH.VALUE7"/>
        <FilterEntries name="where" expression="BR.ETL_DATE BETWEEN EXP_VH.VALUE_START_DATE AND EXP_VH.VALUE_END_DATE" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
    </nodeData>
