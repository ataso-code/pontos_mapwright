        <FilterEntries name="where" expression="INV.SNAPSHOT_DT BETWEEN TO_DATE('&quot; + context.VAR_FROM_ETL_DATE + &quot;', 'DD.MM.YYYY') AND (TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') + 1) - INTERVAL '1' SECOND AND NVL(SEG.CODESHARE_FLT_ID, -1) = -1 AND NOT LEG.LEG_STATUS_CODE IN ('CX', 'DL') AND LEG.FLT_LEG_TYPE_CODE IN (10, 20, 32, 33)" filterKind="WHERE_CLAUSE"/>
