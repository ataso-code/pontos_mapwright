        <DBMapperTableEntries name="CRS_USER_ID"/>
        <DBMapperTableEntries name="ORD_STEP_CODE"/>
      </InputTables>
      <OutputTables name="STG_T_CDL_F_COUPON_ANC_PRODUCT_ORDER_LRY" tableName="STG_T_CDL_F_COUPON_ANC_PRODUCT_ORDER_LRY">
        <DBMapperTableEntries name="ORD_LINE_DT" expression="T1.ORD_LINE_DT"/>
        <DBMapperTableEntries name="INSERT_DTTM" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUN_ID" expression="NULL"/>
        <DBMapperTableEntries name="PAYMENT_CPN_ID" expression="T1.PAYMENT_CPN_ID"/>
        <DBMapperTableEntries name="PNR_ORD_LINE_ID" expression="T1.PNR_ORD_LINE_ID"/>
        <DBMapperTableEntries name="PNR_PAX_ID" expression="T1.PNR_PAX_ID"/>
        <DBMapperTableEntries name="LEG_ID" expression="NVL(T3.LEG_ID, -1)"/>
        <DBMapperTableEntries name="LEG_SEG_ID" expression="NVL(T2.LEG_SEG_ID, -1)"/>
        <DBMapperTableEntries name="SEG_ID" expression="NVL(T3.SEG_ID, -1)"/>
        <DBMapperTableEntries name="PRDCT_ID" expression="T1.PRDCT_ID"/>
        <DBMapperTableEntries name="CRS_USER_ID" expression="T1.CRS_USER_ID"/>
        <DBMapperTableEntries name="ORD_STEP_CODE" expression="NVL(T6.ORD_STEP_CODE, '-1')"/>
        <DBMapperTableEntries name="PAYMENT_STATUS_CODE" expression="T1.PAYMENT_STATUS_CODE"/>
        <DBMapperTableEntries name="ORD_LINE_STATUS_CODE" expression="T1.ORD_LINE_STATUS_CODE"/>
        <DBMapperTableEntries name="ORD_LINE_TEXT" expression="T1.ORD_LINE_TEXT"/>
        <DBMapperTableEntries name="BAG_WEIGHT_KG" expression="CASE WHEN T5.PRDCT_CATEGORY_CODE = 'BAG' THEN 0 ELSE NULL END"/>
        <DBMapperTableEntries name="SEAT_POSITION_CODE" expression="CASE WHEN T5.PRDCT_CATEGORY_CODE = 'SEAT' THEN T1.ORD_LINE_TEXT ELSE '-999' END"/>
        <FilterEntries name="where" expression="(T1.PAYMENT_CPN_ID > 0 AND CASE WHEN T5.PRDCT_CATEGORY_CODE IN ('BAG', 'SEAT', 'OTH', 'EQP') THEN 1 WHEN T4.PRDCT_CODE = 'WPAY' THEN 1 ELSE 0 END = 1) AND (T1.ORD_LINE_DT IN (SELECT DISTINCT ORD_LINE_DT FROM DW_FDL.FDL_RES_PNR_ORDER_LINE WHERE FDL_RES_PNR_ORDER_LINE.UPDATE_DTTM BETWEEN TO_DATE('&quot; + context.VAR_FROM_ETL_DATE + &quot;', 'DD.MM.YYYY') + 1 AND (TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') + 2) - INTERVAL '1' SECOND))" filterKind="WHERE_FILTER"/>
      </OutputTables>
    </nodeData>
  </node>
