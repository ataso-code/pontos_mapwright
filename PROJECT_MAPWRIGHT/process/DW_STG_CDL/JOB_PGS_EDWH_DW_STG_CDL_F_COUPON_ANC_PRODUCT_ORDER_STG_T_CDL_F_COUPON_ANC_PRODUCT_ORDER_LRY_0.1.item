        <DBMapperTableEntries name="ORD_LINE_TEXT" expression="T1.ORD_LINE_TEXT"/>
        <DBMapperTableEntries name="BAG_WEIGHT_KG" expression="CASE WHEN T5.PRDCT_CATEGORY_CODE = 'BAG' THEN 0 ELSE NULL END"/>
        <DBMapperTableEntries name="SEAT_POSITION_CODE" expression="CASE WHEN T5.PRDCT_CATEGORY_CODE = 'SEAT' THEN T1.ORD_LINE_TEXT ELSE '-999' END"/>
        <FilterEntries name="where" expression="(T1.PAYMENT_CPN_ID > 0 AND CASE WHEN T5.PRDCT_CATEGORY_CODE IN ('BAG', 'SEAT', 'OTH', 'EQP') THEN 1 WHEN T4.PRDCT_CODE = 'WPAY' THEN 1 ELSE 0 END = 1) AND (T1.ORD_LINE_DT IN (SELECT DISTINCT ORD_LINE_DT FROM DW_FDL.FDL_RES_PNR_ORDER_LINE WHERE FDL_RES_PNR_ORDER_LINE.UPDATE_DTTM BETWEEN TO_DATE('&quot; + context.VAR_FROM_ETL_DATE + &quot;', 'DD.MM.YYYY') + 1 AND (TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') + 2) - INTERVAL '1' SECOND))" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
