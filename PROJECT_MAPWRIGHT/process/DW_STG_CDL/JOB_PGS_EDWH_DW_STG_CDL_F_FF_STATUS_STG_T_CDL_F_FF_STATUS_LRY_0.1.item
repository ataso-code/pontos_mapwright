        <DBMapperTableEntries name="NEW_FF_MEMBER_FLAG" expression="CASE WHEN TRUNC(MBB.MEMBERSHIP_START_DT, 'MM') = TRUNC(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY'), 'MM') THEN 1 ELSE 0 END"/>
        <DBMapperTableEntries name="LAST_TRN_DT_IN_365_DAYS" expression="NVL(EXP_TRN.LAST_TRN_DT_IN_365_DAYS, TO_DATE('01.01.1900', 'DD.MM.YYYY'))"/>
        <DBMapperTableEntries name="LAST_FLT_TRN_DT_IN_365_DAYS" expression="NVL(EXP_TRN.LAST_FLT_TRN_DT_IN_365_DAYS, TO_DATE('01.01.1900', 'DD.MM.YYYY'))"/>
        <FilterEntries name="where" expression="(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN MBB_HST.VALID_FROM_DT AND MBB_HST.VALID_TO_DT) AND (STC.MEMBERSHIP_STATUS_CTGRY_NAME = 'Open' AND (CASE WHEN MBB.MEMBERSHIP_START_DT > TO_DATE('24.07.2018', 'DD.MM.YYYY') AND MBB.MEMBERSHIP_STATUS_CODE IN ('WA') THEN 1 ELSE 0 END) = 0 AND MBB.MEMBERSHIP_START_DT &lt;= LAST_DAY(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY')))" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
