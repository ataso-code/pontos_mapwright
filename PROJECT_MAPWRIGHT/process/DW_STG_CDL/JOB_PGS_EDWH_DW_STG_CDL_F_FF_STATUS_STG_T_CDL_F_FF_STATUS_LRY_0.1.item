        <DBMapperTableEntries name="MEMBERSHIP_STATUS_CTGRY_ID"/>
      </InputTables>
      <InputTables name="DW_FDL.FDL_LYL_FF_MEMBERSHIP_STATUS_CTGRY" tableName="DW_FDL.FDL_LYL_FF_MEMBERSHIP_STATUS_CTGRY" joinType="INNER_JOIN" alias="STC">
        <DBMapperTableEntries name="SYS_SRC_ID"/>
        <DBMapperTableEntries name="INSERT_DTTM"/>
        <DBMapperTableEntries name="INSERT_RUN_ID"/>
        <DBMapperTableEntries name="UPDATE_DTTM"/>
        <DBMapperTableEntries name="UPDATE_RUN_ID"/>
        <DBMapperTableEntries name="MEMBERSHIP_STATUS_CTGRY_ID" expression="ST.MEMBERSHIP_STATUS_CTGRY_ID" join="true" operator="="/>
        <DBMapperTableEntries name="MEMBERSHIP_STATUS_CTGRY_NAME"/>
