        <DBMapperTableEntries name="SNAPSHOT_DT" expression="TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY')"/>
        <DBMapperTableEntries name="INSERT_DTTM" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="INSERT_RUN_ID" expression="NULL"/>
        <DBMapperTableEntries name="FF_ID" expression="MBB.FF_ID"/>
        <DBMapperTableEntries name="MEMBERSHIP_STATUS_CODE" expression="MBB_HST.MEMBERSHIP_STATUS_CODE"/>
        <DBMapperTableEntries name="PROGRAM_ACTIVENESS_STATUS_ID" expression="NVL(TRN1.PROGRAM_ACTIVENESS_STATUS_ID, 2)"/>
        <DBMapperTableEntries name="FLIGHT_ACTIVENESS_STATUS_ID" expression="NVL(TRN1.FLIGHT_ACTIVENESS_STATUS_ID, 2)"/>
        <DBMapperTableEntries name="REDEMPTION_ACTIVENESS_STATUS_ID" expression="NVL(TRN1.REDEMPTION_ACTIVENESS_STATUS_ID, 2)"/>
        <DBMapperTableEntries name="EARNING_ACTIVENESS_STATUS_ID" expression="NVL(TRN1.EARNING_ACTIVENESS_STATUS_ID, 2)"/>
        <DBMapperTableEntries name="NEW_FF_MEMBER_FLAG" expression="CASE WHEN TRUNC(MBB.MEMBERSHIP_START_DT, 'MM') = TRUNC(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY'), 'MM') THEN 1 ELSE 0 END"/>
        <DBMapperTableEntries name="LAST_TRN_DT_IN_365_DAYS" expression="NVL(TRN1.LAST_TRN_DT_IN_365_DAYS, TO_DATE('01.01.1900', 'DD.MM.YYYY'))"/>
        <DBMapperTableEntries name="LAST_FLT_TRN_DT_IN_365_DAYS" expression="NVL(TRN1.LAST_FLT_TRN_DT_IN_365_DAYS, TO_DATE('01.01.1900', 'DD.MM.YYYY'))"/>
        <FilterEntries name="where" expression="(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') BETWEEN MBB_HST.VALID_FROM_DT AND MBB_HST.VALID_TO_DT) AND (STC.MEMBERSHIP_STATUS_CTGRY_NAME = 'Open' AND (CASE WHEN MBB.MEMBERSHIP_START_DT > TO_DATE('24.07.2018', 'DD.MM.YYYY') AND MBB.MEMBERSHIP_STATUS_CODE IN ('WA') THEN 1 ELSE 0 END) = 0 AND MBB.MEMBERSHIP_START_DT &lt;= LAST_DAY(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY')))" filterKind="WHERE_FILTER"/>
      </OutputTables>
    </nodeData>
  </node>
