        <DBMapperTableEntries name="AWARD_CLAIM_DTTM"/>
        <DBMapperTableEntries name="AWARD_USAGE_TYPE_CODE"/>
        <DBMapperTableEntries name="REDEPOSITED_POINTS_AMT"/>
      </InputTables>
      <OutputTables name="TRN1" tableName="TRN1">
        <DBMapperTableEntries name="FF_ID" expression="TRN.FF_ID"/>
        <DBMapperTableEntries name="PROGRAM_ACTIVENESS_STATUS_ID" expression="1"/>
        <DBMapperTableEntries name="FLIGHT_ACTIVENESS_STATUS_ID" expression="MIN(CASE WHEN TRN_T.LYL_TRN_TYPE_CODE = 'F' THEN 1 ELSE 2 END)"/>
        <DBMapperTableEntries name="REDEMPTION_ACTIVENESS_STATUS_ID" expression="MIN(CASE WHEN NVL(TRN_RDMP.AWARD_CODE, -1) = 'PGS001' THEN 1 ELSE 2 END)"/>
        <DBMapperTableEntries name="EARNING_ACTIVENESS_STATUS_ID" expression="MIN(CASE WHEN TRN_T.LYL_TRN_TYPE_CODE IN ('F', 'P') THEN 1 ELSE 2 END)"/>
        <DBMapperTableEntries name="LAST_TRN_DT_IN_365_DAYS" expression="MAX(LYL_TRN_DT)"/>
        <DBMapperTableEntries name="LAST_FLT_TRN_DT_IN_365_DAYS" expression="MAX(CASE WHEN TRN_T.LYL_TRN_TYPE_CODE = 'F' THEN LYL_TRN_DT END)"/>
        <FilterEntries name="where" expression="(TRN_T.LYL_TRN_TYPE_CODE IN ('F', 'P') OR TRN_C.LYL_TRN_CLASS_CODE = 'GAME_1' OR NVL(TRN_RDMP.AWARD_CODE, -1) = 'PGS001') AND TRN.LYL_TRN_DT BETWEEN TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') - 365 AND TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') AND TRN.DELETED_FLAG = 0" filterKind="WHERE_FILTER"/>
        <FilterEntries name="other" expression="GROUP BY TRN.FF_ID" filterKind="OTHER_FILTER"/>
      </OutputTables>
    </nodeData>
  </node>
