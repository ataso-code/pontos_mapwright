      <InputTables name="DW_FDL.FDL_LYL_TRN_REDEMPTION" tableName="DW_FDL.FDL_LYL_TRN_REDEMPTION" joinType="LEFT_OUTER_JOIN" alias="TRN_RDMP">
        <DBMapperTableEntries name="SYS_SRC_ID"/>
        <DBMapperTableEntries name="INSERT_DTTM"/>
        <DBMapperTableEntries name="INSERT_RUN_ID"/>
        <DBMapperTableEntries name="UPDATE_DTTM"/>
        <DBMapperTableEntries name="UPDATE_RUN_ID"/>
