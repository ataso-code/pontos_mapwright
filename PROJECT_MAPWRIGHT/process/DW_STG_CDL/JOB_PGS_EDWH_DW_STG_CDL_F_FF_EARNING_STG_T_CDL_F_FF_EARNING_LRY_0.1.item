        <DBMapperTableEntries name="POINTS_AMT" expression="SUM(NVL(NVL(TRN_ER.POINTS_AMT, TRN.POINTS_AMT), 0))"/>
        <FilterEntries name="where" expression="(CTG.LYL_TRN_CLASS_CTGRY_CODE = 'E' AND TRN.DELETED_FLAG = 0) AND (TRN.LYL_TRN_DT IN (SELECT DISTINCT LYL_TRN_DT FROM DW_FDL.FDL_LYL_TRN WHERE FDL_LYL_TRN.UPDATE_DTTM BETWEEN TO_DATE('&quot; + context.VAR_FROM_ETL_DATE + &quot;', 'DD.MM.YYYY') + 1 AND (TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') + 2) - INTERVAL '1' SECOND))" filterKind="WHERE_CLAUSE"/>
        <FilterEntries name="other" expression="GROUP BY TRN.LYL_TRN_DT, TRN.FF_ID, TRN.LYL_TRN_CLASS_ID, TRN.LYL_TRN_TYPE_ID, TRN.LYL_PROGRAM_PARTNER_ID" filterKind="OTHER_FILTER"/>
