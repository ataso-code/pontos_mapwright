        <DBMapperTableEntries name="INSERT_RUNID" expression="NULL"/>
        <DBMapperTableEntries name="INSERT_TIMESTAMP" expression="SYSTIMESTAMP"/>
        <DBMapperTableEntries name="FIN_INST_TYPE" expression="F.DESCRIPTION"/>
        <DBMapperTableEntries name="FIN_INST_TYPE_ID" expression="C.FIN_INST_TYPE_ID"/>
        <DBMapperTableEntries name="FIN_INST_NAME" expression="I.NAME"/>
        <DBMapperTableEntries name="DEBIT_DATE" expression="C.STOCK_DATE"/>
        <DBMapperTableEntries name="DEBIT_COST_DATE" expression="C.COST_DATE"/>
        <DBMapperTableEntries name="DEBIT_REF" expression="TC.NAME"/>
        <DBMapperTableEntries name="DEBIT_UNIT" expression="C.NOMINAL"/>
        <DBMapperTableEntries name="DEBIT_PRICE" expression="CASE WHEN C.FIN_INST_TYPE_ID IN ('0000-000001-FIT', '0000-000005-FIT') AND C.NOMINAL &lt;> 0 THEN ROUND(C.AMOUNT / C.NOMINAL, 2) WHEN C.FIN_INST_TYPE_ID = '0000-000003-FIT' AND C.NOMINAL &lt;> 0 THEN ROUND(C.AMOUNT / C.NOMINAL, 6) ELSE C.PRICE END"/>
        <DBMapperTableEntries name="DEBIT_AMOUNT" expression="(CASE WHEN G.UNIT = 0 THEN 0 ELSE C.PRICE * T.NOMINAL / G.UNIT END)"/>
        <DBMapperTableEntries name="DEBIT_COMMISSION" expression="(CASE WHEN C.NOMINAL * T.NOMINAL &lt;> 0 THEN (C.COMMISSION_AMOUNT / C.NOMINAL * T.NOMINAL) ELSE C.COMMISSION_AMOUNT END)"/>
        <DBMapperTableEntries name="CREDIT_UNIT" expression="T.NOMINAL"/>
        <DBMapperTableEntries name="CREDIT_COMMISSION" expression="(CASE WHEN G.NOMINAL * T.NOMINAL &lt;> 0 THEN (G.COMMISSION_AMOUNT / G.NOMINAL * T.NOMINAL) ELSE G.COMMISSION_AMOUNT END)"/>
        <DBMapperTableEntries name="CREDIT_AMOUNT" expression="(CASE WHEN G.UNIT = 0 THEN 0 ELSE T.NOMINAL * T.BUY_PRICE / G.UNIT END)"/>
        <DBMapperTableEntries name="CREDIT_PRICE" expression="CASE WHEN G.FIN_INST_TYPE_ID IN ('0000-000001-FIT', '0000-000005-FIT') AND G.NOMINAL &lt;> 0 THEN ROUND(G.AMOUNT / G.NOMINAL, 2) WHEN G.FIN_INST_TYPE_ID = '0000-000003-FIT' AND G.NOMINAL &lt;> 0 THEN ROUND(G.AMOUNT / G.NOMINAL, 6) ELSE G.PRICE END"/>
        <DBMapperTableEntries name="CREDIT_DATE" expression="G.STOCK_DATE"/>
        <DBMapperTableEntries name="CREDIT_COST_DATE" expression="G.COST_DATE"/>
        <DBMapperTableEntries name="CREDIT_REF" expression="TG.NAME"/>
        <DBMapperTableEntries name="PROFIT_LOSS" expression="CASE WHEN C.TRANS_TYPE_ID IN ('0000-000016-TYP', '0000-000042-TYP', '0000-000024-TYP', '0000-000065-TYP') THEN C.AMOUNT WHEN NOT C.TRANS_TYPE_ID IN ('0000-000016-TYP', '0000-000042-TYP', '0000-000024-TYP', '0000-000065-TYP') AND C.PRICE = 0 THEN 0 WHEN NOT C.TRANS_TYPE_ID IN ('0000-000016-TYP', '0000-000042-TYP', '0000-000024-TYP', '0000-000065-TYP') AND C.PRICE &lt;> 0 THEN T.PROFIT_LOSS END"/>
        <DBMapperTableEntries name="RESULT_DESCRIPTION" expression="R.DESCRIPTION"/>
        <DBMapperTableEntries name="OUT_ID" expression="T.OUT_ID"/>
        <DBMapperTableEntries name="IN_ID" expression="T.IN_ID"/>
        <DBMapperTableEntries name="CUSTOMER_ID" expression="C.CUSTOMER_ID"/>
        <DBMapperTableEntries name="FIN_INST_ID" expression="I.FIN_INST_ID"/>
        <DBMapperTableEntries name="NET_DEBIT_AMOUNT" expression="0.0"/>
        <DBMapperTableEntries name="NET_CREDIT_AMOUNT" expression="0.0"/>
        <DBMapperTableEntries name="PERIOD" expression="P.DESCRIPTION"/>
        <DBMapperTableEntries name="IN_EXC_RATE" expression="IN_STOCK.EXCHANGE_RATE"/>
        <DBMapperTableEntries name="OUT_EXC_RATE" expression="OUT_STOCK.EXCHANGE_RATE"/>
        <DBMapperTableEntries name="CUSTOMER_NO" expression="CUS.CUSTOMER_EXT_ID"/>
        <DBMapperTableEntries name="CUSTOMER_NAME" expression="CUS.NAME || ' ' || CUS.LAST_NAME"/>
        <DBMapperTableEntries name="DEBIT_ACCOUNT_EXT_ID" expression="''"/>
        <FilterEntries name="where" expression="(T.CALC_DATE BETWEEN P.START_DATE AND P.END_DATE) AND (NOT TC.NAME IN ('SDDC', 'VIRC', 'FIZC')) AND (T.CALC_DATE BETWEEN TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY') AND TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY')) AND (T.CALC_DATE &lt;= TO_DATE('30.07.2008', 'DD.MM.YYYY')) AND (T.ORG_ID = '0000-000001-ORG')" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
    </nodeData>
  </node>
