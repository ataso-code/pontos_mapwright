        <DBMapperTableEntries name="SELL_NOMINAL"/>
        <DBMapperTableEntries name="COM_RATE"/>
        <DBMapperTableEntries name="PRICE"/>
        <DBMapperTableEntries name="EXCHANGE_RATE"/>
        <DBMapperTableEntries name="REMAINING"/>
        <DBMapperTableEntries name="NOMINAL"/>
        <DBMapperTableEntries name="COMMISSION_AMOUNT"/>
      </InputTables>
      <OutputTables name="EXP_EQ_TAX_DATA" tableName="EXP_EQ_TAX_DATA">
        <DBMapperTableEntries name="IS_BUY" expression="T_STG_SHR_EQ_DLY_PL_TM1_TMP03.IS_BUY"/>
        <DBMapperTableEntries name="IS_SELL" expression="T_STG_SHR_EQ_DLY_PL_TM1_TMP03.IS_SELL"/>
        <DBMapperTableEntries name="CALC_COM_AMOUNT" expression="CASE WHEN T_STG_SHR_EQ_DLY_PL_TM1_TMP03.IS_BUY = 1 THEN T_STG_SHR_EQ_DLY_PL_TM1_TMP03.COM_RATE * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.SELL_NOMINAL * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.PRICE * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.EXCHANGE_RATE WHEN T_STG_SHR_EQ_DLY_PL_TM1_TMP03.IS_SELL = 1 THEN ((ABS(T_STG_SHR_EQ_DLY_PL_TM1_TMP03.NOMINAL) - T_STG_SHR_EQ_DLY_PL_TM1_TMP03.REMAINING) / NVL(NULLIF(ABS(T_STG_SHR_EQ_DLY_PL_TM1_TMP03.NOMINAL), 0), 1)) * ABS(T_STG_SHR_EQ_DLY_PL_TM1_TMP03.COMMISSION_AMOUNT * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.EXCHANGE_RATE) END"/>
        <DBMapperTableEntries name="CALC_COM_AMOUNT_OC" expression="CASE WHEN T_STG_SHR_EQ_DLY_PL_TM1_TMP03.IS_BUY = 1 THEN T_STG_SHR_EQ_DLY_PL_TM1_TMP03.COM_RATE * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.SELL_NOMINAL * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.PRICE WHEN T_STG_SHR_EQ_DLY_PL_TM1_TMP03.IS_SELL = 1 THEN ((ABS(T_STG_SHR_EQ_DLY_PL_TM1_TMP03.NOMINAL) - T_STG_SHR_EQ_DLY_PL_TM1_TMP03.REMAINING) / NVL(NULLIF(ABS(T_STG_SHR_EQ_DLY_PL_TM1_TMP03.NOMINAL), 0), 1)) * ABS(T_STG_SHR_EQ_DLY_PL_TM1_TMP03.COMMISSION_AMOUNT) END"/>
        <DBMapperTableEntries name="COST_OF_STOCK_WITH_COM" expression="T_STG_SHR_EQ_DLY_PL_TM1_TMP03.IS_BUY * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.SELL_NOMINAL * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.PRICE * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.EXCHANGE_RATE"/>
        <DBMapperTableEntries name="COST_OF_STOCK_WITH_COM_OC" expression="T_STG_SHR_EQ_DLY_PL_TM1_TMP03.IS_BUY * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.SELL_NOMINAL * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.PRICE"/>
        <DBMapperTableEntries name="REVENUE_OF_STOCK_WITH_COM" expression="T_STG_SHR_EQ_DLY_PL_TM1_TMP03.IS_SELL * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.PRICE * (ABS(T_STG_SHR_EQ_DLY_PL_TM1_TMP03.NOMINAL) - T_STG_SHR_EQ_DLY_PL_TM1_TMP03.REMAINING) * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.EXCHANGE_RATE"/>
        <DBMapperTableEntries name="REVENUE_OF_STOCK_WITH_COM_OC" expression="T_STG_SHR_EQ_DLY_PL_TM1_TMP03.IS_SELL * T_STG_SHR_EQ_DLY_PL_TM1_TMP03.PRICE * (ABS(T_STG_SHR_EQ_DLY_PL_TM1_TMP03.NOMINAL) - T_STG_SHR_EQ_DLY_PL_TM1_TMP03.REMAINING)"/>
        <DBMapperTableEntries name="VALUE_DATE" expression="T_STG_SHR_EQ_DLY_PL_TM1_TMP03.VALUE_DATE"/>
        <DBMapperTableEntries name="FIN_INST_ID" expression="T_STG_SHR_EQ_DLY_PL_TM1_TMP03.FIN_INST_ID"/>
        <DBMapperTableEntries name="ACCOUNT_ID" expression="T_STG_SHR_EQ_DLY_PL_TM1_TMP03.ACCOUNT_ID"/>
        <DBMapperTableEntries name="CUSTOMER_ID" expression="T_STG_SHR_EQ_DLY_PL_TM1_TMP03.CUSTOMER_ID"/>
      </OutputTables>
    </nodeData>
