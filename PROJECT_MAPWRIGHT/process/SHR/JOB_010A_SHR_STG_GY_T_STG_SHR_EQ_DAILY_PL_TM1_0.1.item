      <InputTables name="DGYTSTG.T_STG_SHR_EQ_DLY_PL_TM1_TMP03" tableName="DGYTSTG.T_STG_SHR_EQ_DLY_PL_TM1_TMP03" joinType="NO_JOIN" alias="T_STG_SHR_EQ_DLY_PL_TM1_TMP03">
