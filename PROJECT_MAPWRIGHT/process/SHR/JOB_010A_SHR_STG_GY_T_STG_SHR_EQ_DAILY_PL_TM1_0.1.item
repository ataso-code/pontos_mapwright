      <column key="false" length="38" name="PL" nullable="true" precision="10" sourceType="NUMBER" type="id_BigDecimal" usefulColumn="true"/>
      <column key="false" length="38" name="PL_OC" nullable="true" precision="10" sourceType="NUMBER" type="id_BigDecimal" usefulColumn="true"/>
    </metadata>
    <nodeData xsi:type="TalendDBMap:DBMapData">
      <InputTables name="EXP_EQ_TAX_DATA" tableName="EXP_EQ_TAX_DATA" joinType="NO_JOIN" alias="EXP_EQ_TAX_DATA">
        <DBMapperTableEntries name="IS_BUY"/>
        <DBMapperTableEntries name="IS_SELL"/>
        <DBMapperTableEntries name="CALC_COM_AMOUNT"/>
        <DBMapperTableEntries name="CALC_COM_AMOUNT_OC"/>
        <DBMapperTableEntries name="COST_OF_STOCK_WITH_COM"/>
        <DBMapperTableEntries name="COST_OF_STOCK_WITH_COM_OC"/>
        <DBMapperTableEntries name="REVENUE_OF_STOCK_WITH_COM"/>
        <DBMapperTableEntries name="REVENUE_OF_STOCK_WITH_COM_OC"/>
        <DBMapperTableEntries name="VALUE_DATE"/>
        <DBMapperTableEntries name="FIN_INST_ID"/>
        <DBMapperTableEntries name="ACCOUNT_ID"/>
        <DBMapperTableEntries name="CUSTOMER_ID"/>
      </InputTables>
      <OutputTables name="EXP_SHR_EQ_PL_DATA" tableName="EXP_SHR_EQ_PL_DATA">
        <DBMapperTableEntries name="VALUE_DATE" expression="EXP_EQ_TAX_DATA.VALUE_DATE"/>
        <DBMapperTableEntries name="CUSTOMER_ID" expression="EXP_EQ_TAX_DATA.CUSTOMER_ID"/>
        <DBMapperTableEntries name="ACCOUNT_ID" expression="EXP_EQ_TAX_DATA.ACCOUNT_ID"/>
        <DBMapperTableEntries name="FIN_INST_ID" expression="EXP_EQ_TAX_DATA.FIN_INST_ID"/>
        <DBMapperTableEntries name="COMMISSION_AMOUNT" expression="ROUND(SUM(EXP_EQ_TAX_DATA.CALC_COM_AMOUNT), 2)"/>
        <DBMapperTableEntries name="COMMISSION_AMOUNT_OC" expression="ROUND(SUM(EXP_EQ_TAX_DATA.CALC_COM_AMOUNT_OC), 2)"/>
        <DBMapperTableEntries name="COST_OF_STOCK" expression="ROUND(SUM(EXP_EQ_TAX_DATA.COST_OF_STOCK_WITH_COM - (EXP_EQ_TAX_DATA.IS_BUY * EXP_EQ_TAX_DATA.CALC_COM_AMOUNT)), 2)"/>
        <DBMapperTableEntries name="COST_OF_STOCK_OC" expression="ROUND(SUM(EXP_EQ_TAX_DATA.COST_OF_STOCK_WITH_COM_OC - (EXP_EQ_TAX_DATA.IS_BUY * EXP_EQ_TAX_DATA.CALC_COM_AMOUNT_OC)), 2)"/>
        <DBMapperTableEntries name="REVENUE_OF_STOCK" expression="ROUND(SUM(EXP_EQ_TAX_DATA.REVENUE_OF_STOCK_WITH_COM - EXP_EQ_TAX_DATA.CALC_COM_AMOUNT), 2)"/>
        <DBMapperTableEntries name="REVENUE_OF_STOCK_OC" expression="ROUND(SUM(EXP_EQ_TAX_DATA.REVENUE_OF_STOCK_WITH_COM_OC - EXP_EQ_TAX_DATA.CALC_COM_AMOUNT_OC), 2)"/>
        <DBMapperTableEntries name="PL" expression="ROUND(SUM(EXP_EQ_TAX_DATA.REVENUE_OF_STOCK_WITH_COM - EXP_EQ_TAX_DATA.CALC_COM_AMOUNT) - (SUM(EXP_EQ_TAX_DATA.COST_OF_STOCK_WITH_COM - EXP_EQ_TAX_DATA.CALC_COM_AMOUNT) + SUM(EXP_EQ_TAX_DATA.CALC_COM_AMOUNT)), 2)"/>
        <DBMapperTableEntries name="PL_OC" expression="ROUND(SUM(EXP_EQ_TAX_DATA.REVENUE_OF_STOCK_WITH_COM_OC - EXP_EQ_TAX_DATA.CALC_COM_AMOUNT_OC) - (SUM(EXP_EQ_TAX_DATA.COST_OF_STOCK_WITH_COM_OC - EXP_EQ_TAX_DATA.CALC_COM_AMOUNT_OC) + SUM(EXP_EQ_TAX_DATA.CALC_COM_AMOUNT_OC)), 2)"/>
        <FilterEntries name="other" expression="GROUP BY EXP_EQ_TAX_DATA.VALUE_DATE, EXP_EQ_TAX_DATA.CUSTOMER_ID, EXP_EQ_TAX_DATA.ACCOUNT_ID, EXP_EQ_TAX_DATA.FIN_INST_ID" filterKind="OTHER_FILTER"/>
      </OutputTables>
    </nodeData>
  </node>
