        <DBMapperTableEntries name="GY_CUS_CODE" expression="EXP_CRD.GY_CUS_CODE"/>
        <DBMapperTableEntries name="ACC_ID" expression="EXP_CRD.ACC_ID"/>
        <DBMapperTableEntries name="ACC_CON_DATE" expression="EXP_CRD.ACC_CON_DATE"/>
        <DBMapperTableEntries name="GY_PF_CODE" expression="EXP_CRD.GY_PF_CODE"/>
        <DBMapperTableEntries name="GY_PF_NAME" expression="EXP_CRD.GY_PF_NAME"/>
        <DBMapperTableEntries name="ACC_DIV_CODE" expression="EXP_CRD.ACC_DIV_CODE"/>
        <DBMapperTableEntries name="ACC_DIV_NAME" expression="EXP_CRD.ACC_DIV_NAME"/>
        <DBMapperTableEntries name="GY_ACC_OPEN_DATE" expression="EXP_CRD.GY_ACC_OPEN_DATE"/>
        <DBMapperTableEntries name="GY_ACC_CLOSE_DATE" expression="EXP_CRD.GY_ACC_CLOSE_DATE"/>
        <DBMapperTableEntries name="PR_GY_PF_CODE" expression="EXP_CRD.PR_GY_PF_CODE"/>
        <DBMapperTableEntries name="NX_GY_PF_CODE" expression="EXP_CRD.NX_GY_PF_CODE"/>
        <DBMapperTableEntries name="PR_ACC_DIV_CODE" expression="EXP_CRD.PR_ACC_DIV_CODE"/>
        <DBMapperTableEntries name="NX_ACC_DIV_CODE" expression="EXP_CRD.NX_ACC_DIV_CODE"/>
        <DBMapperTableEntries name="GY_REL_TP_CODE" expression="CASE WHEN EXP_CRD.GY_ACC_CLOSE_DATE &lt; TO_DATE('9999-12-31', 'YYYY-MM-DD') AND EXP_CRD.NX_GY_PF_CODE IS NULL THEN 'DIS' WHEN NOT EXP_CRD.PR_GY_PF_CODE IS NULL AND EXP_CRD.GY_PF_CODE &lt;> '0000-00011H-POS' AND EXP_CRD.NX_GY_PF_CODE IS NULL THEN 'CON' WHEN EXP_CRD.NX_GY_PF_CODE IS NULL THEN 'CON' WHEN EXP_CRD.ACC_DIV_CODE &lt;> NVL(EXP_CRD.NX_ACC_DIV_CODE, '-') THEN 'DIS' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE &lt;> '0000-00011H-POS' AND EXP_CRD.NX_GY_PF_CODE &lt;> '0000-00011H-POS' THEN 'CHG' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') = '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE &lt;> '0000-00011H-POS' AND COALESCE(EXP_CRD.NX_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' THEN 'CHG' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE = '0000-00011H-POS' AND COALESCE(EXP_CRD.NX_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' THEN 'DIS' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE = '0000-00011H-POS' AND COALESCE(EXP_CRD.NX_GY_PF_CODE, '-') = '0000-00011H-POS' THEN 'DIS' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE &lt;> '0000-00011H-POS' AND COALESCE(EXP_CRD.NX_GY_PF_CODE, '-') = '0000-00011H-POS' THEN 'DIS' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') = '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE &lt;> '0000-00011H-POS' AND COALESCE(EXP_CRD.NX_GY_PF_CODE, '-') = '0000-00011H-POS' THEN 'DIS' ELSE '#NA' END"/>
        <DBMapperTableEntries name="GY_REL_TP_NAME" expression="CASE WHEN EXP_CRD.GY_ACC_CLOSE_DATE &lt; TO_DATE('9999-12-31', 'YYYY-MM-DD') AND EXP_CRD.NX_GY_PF_CODE IS NULL THEN 'ÇÖZÜLME-CASE-01' WHEN NOT EXP_CRD.PR_GY_PF_CODE IS NULL AND EXP_CRD.GY_PF_CODE &lt;> '0000-00011H-POS' AND EXP_CRD.NX_GY_PF_CODE IS NULL THEN 'BAĞLANMA-CASE-02' WHEN EXP_CRD.NX_GY_PF_CODE IS NULL THEN 'BAĞLANMA-CASE-03' WHEN EXP_CRD.ACC_DIV_CODE &lt;> NVL(EXP_CRD.NX_ACC_DIV_CODE, '-') THEN 'ÇÖZÜLME-CASE-04' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE &lt;> '0000-00011H-POS' AND EXP_CRD.NX_GY_PF_CODE &lt;> '0000-00011H-POS' THEN 'DEĞİŞİKLİK-CASE-05' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') = '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE &lt;> '0000-00011H-POS' AND COALESCE(EXP_CRD.NX_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' THEN 'DEĞİŞİKLİK-CASE-06' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE = '0000-00011H-POS' AND COALESCE(EXP_CRD.NX_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' THEN 'ÇÖZÜLME-CASE-07' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE = '0000-00011H-POS' AND COALESCE(EXP_CRD.NX_GY_PF_CODE, '-') = '0000-00011H-POS' THEN 'ÇÖZÜLME-CASE-08' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') &lt;> '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE &lt;> '0000-00011H-POS' AND COALESCE(EXP_CRD.NX_GY_PF_CODE, '-') = '0000-00011H-POS' THEN 'ÇÖZÜLME-CASE-09' WHEN COALESCE(EXP_CRD.PR_GY_PF_CODE, '-') = '0000-00011H-POS' AND EXP_CRD.GY_PF_CODE &lt;> '0000-00011H-POS' AND COALESCE(EXP_CRD.NX_GY_PF_CODE, '-') = '0000-00011H-POS' THEN 'ÇÖZÜLME-CASE-10' ELSE '#NA' END"/>
      </OutputTables>
    </nodeData>
  </node>
