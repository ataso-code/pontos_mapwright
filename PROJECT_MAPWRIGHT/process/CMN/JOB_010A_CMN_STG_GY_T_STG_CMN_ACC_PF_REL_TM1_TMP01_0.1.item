        <DBMapperTableEntries name="GY_ACC_CLOSE_DATE" expression="CASE WHEN TO_CHAR(ACC.ACC_CLOSE_DATE, 'YYYY') = '9999' THEN TRUNC(ACC.ACC_CLOSE_DATE) ELSE TRUNC(ACC.ACC_CLOSE_DATE) - 1 END"/>
        <DBMapperTableEntries name="GY_ACC_CLOSE_DESC" expression="NVL(BRK.ACC_CLOSE_DESC, '_')"/>
        <FilterEntries name="where" expression="(C2C.PARTY_REL_ROLE_ID = 'CON2CUS~40012') AND (C2C.DWH_STATUS = 1) AND (CUS.DWH_STATUS = 1) AND (CASE WHEN CLS.BRK_ACC_CLS_CODE &lt;> 'FX' AND CAST(DIV.DIV_CODE AS INT) IN (6, 7) THEN 0 ELSE 1 END = 1) AND (DIV.DWH_STATUS = 1) AND (CLS.DWH_STATUS = 1) AND (TO_DATE(TO_CHAR(TO_DATE('&quot; + context.VAR_ETL_DATE + &quot;', 'DD.MM.YYYY'), 'YYYYMMDD'), 'YYYYMMDD') BETWEEN ACC.DWH_VALID_FROM AND ACC.DWH_VALID_UNTIL) AND (BRK.DWH_STATUS = 1) AND (ACC.DWH_STATUS = 1)" filterKind="WHERE_CLAUSE"/>
      </OutputTables>
